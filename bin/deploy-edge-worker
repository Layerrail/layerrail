#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../config"
require "excon"
require "json"
require "uri"

account_id = Config.cloudflare_account_id || ENV["CLOUDFLARE_ACCOUNT_ID"]
api_token = Config.cloudflare_api_token || Config.cloudflare_dns_api_token || ENV["CLOUDFLARE_API_TOKEN"] || ENV["CLOUDFLARE_DNS_API_TOKEN"]
zone_id = Config.cloudflare_dns_zone_id || ENV["CLOUDFLARE_DNS_ZONE_ID"]
script_name = Config.edge_worker_name
resolver_url = "#{Config.base_url.delete_suffix("/")}/edge-runtime/resolve"

abort "CLOUDFLARE_ACCOUNT_ID is required" unless account_id
abort "CLOUDFLARE_API_TOKEN is required" unless api_token
abort "CLOUDFLARE_DNS_ZONE_ID is required" unless zone_id

worker = <<~JS
  const RESOLVER_URL = #{resolver_url.to_json};
  const HOP_BY_HOP = new Set(["connection", "keep-alive", "proxy-authenticate", "proxy-authorization", "te", "trailer", "transfer-encoding", "upgrade"]);

  addEventListener("fetch", event => {
    event.respondWith(handleRequest(event.request, event));
  });

  async function handleRequest(request, event) {
      const host = request.headers.get("host")?.toLowerCase();
      if (!host) return new Response("Missing host\\n", { status: 400 });

      const resolveUrl = new URL(RESOLVER_URL);
      resolveUrl.searchParams.set("host", host);
      const resolved = await fetch(resolveUrl.toString(), { headers: { "Accept": "application/json" } });
      if (!resolved.ok) return new Response("Edge service not found\\n", { status: 404 });

      const config = await resolved.json();
      const incoming = new URL(request.url);
      const origin = new URL(config.origin_url);
      const upstream = new URL(origin.toString());
      upstream.pathname = `${origin.pathname.replace(/\\/$/, "")}${incoming.pathname}`;
      upstream.search = incoming.search || origin.search;

      const headers = new Headers(request.headers);
      for (const key of HOP_BY_HOP) headers.delete(key);
      headers.set("host", origin.host);
      headers.set("x-forwarded-host", host);
      headers.set("x-layerrail-edge", "cloudflare-worker");

      const cacheable = request.method === "GET" && config.cache_mode !== "bypass";
      const cache = caches.default;
      if (cacheable) {
        const cached = await cache.match(request);
        if (cached) return cached;
      }

      const response = await fetch(upstream.toString(), {
        method: request.method,
        headers,
        body: ["GET", "HEAD"].includes(request.method) ? undefined : request.body,
        redirect: "manual"
      });

      const outHeaders = new Headers(response.headers);
      outHeaders.set("x-layerrail-edge", "hit");
      const out = new Response(response.body, { status: response.status, statusText: response.statusText, headers: outHeaders });
      if (cacheable && response.ok) event.waitUntil(cache.put(request, out.clone()));
      return out;
  }
JS

conn = Excon.new("https://api.cloudflare.com", headers: {"Authorization" => "Bearer #{api_token}", "Content-Type" => "application/javascript"})
conn.put(path: "/client/v4/accounts/#{account_id}/workers/scripts/#{script_name}", body: worker, expects: [200, 201])

routes_conn = Excon.new("https://api.cloudflare.com", headers: {"Authorization" => "Bearer #{api_token}", "Content-Type" => "application/json"})
routes = JSON.parse(routes_conn.get(path: "/client/v4/zones/#{zone_id}/workers/routes?per_page=100", expects: 200).body).fetch("result")
pattern = "*.#{Config.edge_service_hostname}/*"
payload = {pattern:, script: script_name}.to_json
existing = routes.find { it["pattern"] == pattern }
if existing
  routes_conn.put(path: "/client/v4/zones/#{zone_id}/workers/routes/#{existing.fetch("id")}", body: payload, expects: [200, 201])
else
  routes_conn.post(path: "/client/v4/zones/#{zone_id}/workers/routes", body: payload, expects: [200, 201])
end

dns_records_path = "/client/v4/zones/#{zone_id}/dns_records"
edge_dns = JSON.parse(routes_conn.get(path: "#{dns_records_path}?type=CNAME&name=#{URI.encode_www_form_component("*.#{Config.edge_service_hostname}")}", expects: 200).body).fetch("result")
dns_payload = {type: "CNAME", name: "*.#{Config.edge_service_hostname}", content: Config.edge_proxy_hostname, ttl: 1, proxied: true}.to_json
if edge_dns.empty?
  routes_conn.post(path: dns_records_path, body: dns_payload, expects: [200, 201])
else
  routes_conn.patch(path: "#{dns_records_path}/#{edge_dns.first.fetch("id")}", body: dns_payload, expects: [200, 201])
end

puts "Deployed #{script_name} for #{pattern}"
