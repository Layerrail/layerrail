#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../loader"

abort "Set POLAR_ACCESS_TOKEN first." unless Config.polar_access_token

amount_cents = Integer(ENV.fetch("POLAR_VERIFICATION_AMOUNT_CENTS", "400"), 10)
currency = ENV.fetch("POLAR_VERIFICATION_CURRENCY", "usd")
name = ENV.fetch("POLAR_VERIFICATION_PRODUCT_NAME", "LayerRail Verification Package")
description = ENV.fetch(
  "POLAR_VERIFICATION_PRODUCT_DESCRIPTION",
  "One-time billing verification used to unlock a LayerRail project for paid infrastructure."
)

metadata = {
  layerrail_role: "verification_package",
  layerrail_amount_cents: amount_cents
}

price = {
  amount_type: "fixed",
  price_currency: currency,
  price_amount: amount_cents
}

existing = PolarClient.list_products.fetch("items", []).find do |product|
  product_metadata = product["metadata"] || {}
  product_metadata["layerrail_role"] == "verification_package" && !product["is_archived"]
end

product_payload = {
  name:,
  description:,
  recurring_interval: nil,
  prices: [price],
  metadata: (existing&.fetch("metadata", {}) || {}).merge(metadata),
  visibility: "private"
}

existing_prices = existing ? existing.fetch("prices", []) : []
active_fixed_price = existing_prices.find do |product_price|
  !product_price["is_archived"] && product_price["amount_type"] == "fixed"
end

price_matches = active_fixed_price &&
  active_fixed_price["price_currency"] == currency &&
  active_fixed_price["price_amount"].to_i == amount_cents
metadata_matches = existing && existing.fetch("metadata", {})["layerrail_amount_cents"].to_i == amount_cents

product = if existing && price_matches && metadata_matches
  existing
elsif existing
  PolarClient.update_product(existing.fetch("id"), product_payload)
else
  PolarClient.create_product(product_payload)
end

puts "POLAR_VERIFICATION_PRODUCT_ID=#{product.fetch("id")}"
puts "POLAR_VERIFICATION_AMOUNT_CENTS=#{amount_cents}"
