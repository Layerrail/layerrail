#!/usr/bin/env ruby
# frozen_string_literal: true

require "date"
require "json"
require_relative "../loader"

if ENV["RESET_EXISTING_INVOICES"] == "1"
  abort "Existing invoices must be preserved. The finalizer now retries their missing notifications."
end

value = ENV["INVOICE_MONTH"]
if value && !/\A\d{4}-\d{2}\z/.match?(value)
  abort "INVOICE_MONTH must use YYYY-MM format."
end
begin
  month = value ? Date.strptime(value, "%Y-%m") : Date.new(Time.now.utc.year, Time.now.utc.month, 1) << 1
rescue Date::Error
  abort "INVOICE_MONTH must use YYYY-MM format."
end
if month < MonthlyInvoiceFinalizer::FIRST_AUTOMATIC_MONTH && ENV["BACKFILL_RECONCILED"] != "1"
  abort "Audit historical delivery first, then set BACKFILL_RECONCILED=1 for an explicit backfill."
end

project_ids = ENV.fetch("PROJECT_IDS", "").split(",").map(&:strip).reject(&:empty?)
project_ids.concat(ENV.fetch("PROJECT_UBIDS", "").split(",").map(&:strip).reject(&:empty?).map do |ubid|
  Project[ubid]&.id || abort("Could not find project #{ubid}")
end)
rate = Float(ENV.fetch("EUR_RATE")) if ENV["EUR_RATE"]
result = MonthlyInvoiceFinalizer.new(month:, project_ids: project_ids.uniq, eur_rate: rate, dry_run: ENV["DRY_RUN"] == "1").run
puts JSON.generate(result)
exit(result[:failed].zero? ? 0 : 1)
