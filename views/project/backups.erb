<% @page_title = "Backups"

protected_count = @backup_rows.count { it[:protected] }
needs_attention_count = @backup_rows.count { !it[:protected] || it[:error] }
backup_total = @backup_rows.sum { it[:count].to_i }
%>

<%== part("components/page_header", title: "Backups") %>

<div class="space-y-6">
  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-lg bg-white p-5 shadow">
      <div class="text-sm font-medium text-gray-500">Protected resources</div>
      <div class="mt-2 text-3xl font-semibold tracking-tight text-layerrail-600"><%= protected_count %></div>
    </div>
    <div class="rounded-lg bg-white p-5 shadow">
      <div class="text-sm font-medium text-gray-500">Available restore points</div>
      <div class="mt-2 text-3xl font-semibold tracking-tight text-layerrail-600"><%= backup_total %></div>
    </div>
    <div class="rounded-lg bg-white p-5 shadow">
      <div class="text-sm font-medium text-gray-500">Needs attention</div>
      <div class="mt-2 text-3xl font-semibold tracking-tight text-layerrail-600"><%= needs_attention_count %></div>
    </div>
  </div>

  <div class="overflow-hidden rounded-lg bg-white shadow">
    <div class="border-b border-gray-200 px-6 py-5">
      <h2 class="text-base font-semibold leading-6 text-gray-900">Service backup coverage</h2>
      <p class="mt-1 text-sm text-gray-500">PostgreSQL and Kubernetes backup status from the running services in this project.</p>
    </div>

    <% if @backup_rows.empty? %>
      <div class="px-6 py-12 text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-layerrail-50 text-layerrail-600">
          <%== part("components/icon", name: "hero-archive-box", classes: "h-6 w-6") %>
        </div>
        <h3 class="mt-4 text-sm font-semibold text-gray-900">No managed backups yet</h3>
        <p class="mt-1 text-sm text-gray-500">Create a PostgreSQL database or Kubernetes cluster to see backup coverage here.</p>
      </div>
    <% else %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Resource</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Status</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Restore points</th>
              <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Window</th>
              <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wide text-gray-500">Action</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-200 bg-white">
            <% @backup_rows.each do |row| %>
              <tr>
                <td class="whitespace-nowrap px-6 py-4">
                  <div class="text-sm font-medium text-gray-900"><%= row[:name] %></div>
                  <div class="text-sm text-gray-500"><%= row[:type] %> · <%= row[:location] %></div>
                </td>
                <td class="whitespace-nowrap px-6 py-4">
                  <% if row[:error] %>
                    <span class="inline-flex rounded-full bg-yellow-50 px-2 py-1 text-xs font-medium text-yellow-800 ring-1 ring-inset ring-yellow-600/20">Needs check</span>
                    <div class="mt-1 text-xs text-gray-500"><%= row[:error] %></div>
                  <% elsif row[:protected] %>
                    <span class="inline-flex rounded-full bg-green-50 px-2 py-1 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">Protected</span>
                  <% else %>
                    <span class="inline-flex rounded-full bg-gray-50 px-2 py-1 text-xs font-medium text-gray-600 ring-1 ring-inset ring-gray-500/10">Waiting for first backup</span>
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900"><%= row[:count] %></td>
                <td class="px-6 py-4 text-sm text-gray-500">
                  <% if row[:earliest_restore_time] && row[:latest_restore_time] %>
                    <%= row[:earliest_restore_time].utc.strftime("%b %-d, %H:%M UTC") %> to <%= row[:latest_restore_time].utc.strftime("%b %-d, %H:%M UTC") %>
                  <% elsif row[:latest_backup_started_at] %>
                    Last backup started <%= row[:latest_backup_started_at].utc.strftime("%b %-d, %H:%M UTC") %>
                  <% elsif row[:next_backup_time] %>
                    Next check <%= row[:next_backup_time].utc.strftime("%b %-d, %H:%M UTC") %>
                  <% else %>
                    Not available yet
                  <% end %>
                </td>
                <td class="whitespace-nowrap px-6 py-4 text-right text-sm font-medium">
                  <a href="<%= row[:path] %>" class="text-layerrail-600 hover:text-layerrail-700">Open</a>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>

  <div class="rounded-lg bg-white p-6 shadow">
    <div class="flex items-start gap-4">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-lg bg-layerrail-50 text-layerrail-600">
        <%== part("components/icon", name: "hero-server-stack", classes: "h-5 w-5") %>
      </div>
      <div>
        <h2 class="text-base font-semibold text-gray-900">Virtual machine backups</h2>
        <p class="mt-1 text-sm text-gray-500">
          This project has <%= @vm_backup_count %> virtual machine<%= @vm_backup_count == 1 ? "" : "s" %>, with <%= @vm_backup_policy_count %> backup polic<%= @vm_backup_policy_count == 1 ? "y" : "ies" %> enabled. Open a VM and use the Backups tab to enable scheduled disk snapshots or create an immediate backup.
        </p>
      </div>
    </div>
  </div>
</div>
