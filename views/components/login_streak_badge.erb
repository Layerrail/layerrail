<%# locals: (account:) %>
<% if (badge = account.login_streak_badge) %>
  <span
    class="inline-flex items-center gap-1.5 rounded-full border border-slate-200 bg-white px-2 py-0.5 text-sm leading-5 text-slate-600 shadow-sm"
    title="<%= badge[:title] %>"
    aria-label="<%= badge[:label] %>"
  >
    <span class="relative inline-grid h-4 w-4 shrink-0 place-items-center text-sm leading-none" aria-hidden="true">
      <span><%= badge[:primary] %></span>
      <span class="absolute -right-1 -top-1 text-[0.5rem] leading-none"><%= badge[:accent] %></span>
    </span>
    <span class="whitespace-nowrap"><%= badge[:label] %></span>
  </span>
<% end %>
