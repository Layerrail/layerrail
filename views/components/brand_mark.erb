<%# locals: (variant: "primary", compact: false) %>
<%
src = if compact
  "/brand/layerrail/layerrail-console-mark.png"
else
  variant == "white" ? "/brand/layerrail/layerrail-console-logo-white.png" : "/brand/layerrail/layerrail-console-logo.png"
end

classes = compact ? "block h-9 w-9" : "block h-10 w-auto"
%>

<img src="<%= src %>" alt="LayerRail" class="<%= classes %> object-contain">
