<%# locals: (variant: "primary", compact: false) %>
<%
src = if compact
  variant == "white" ? "/brand/layerrail/layerrail-mark-white.svg" : "/brand/layerrail/layerrail-mark.svg"
else
  variant == "white" ? "/brand/layerrail/layerrail-logo-white.svg" : "/brand/layerrail/layerrail-logo-primary.svg"
end

classes = compact ? "block h-9 w-9" : "block h-10 w-auto"
%>

<img src="<%= src %>" alt="LayerRail" class="<%= classes %> object-contain">
