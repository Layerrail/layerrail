<%# locals: (tabs:) %>
<div class="mb-6 max-w-full overflow-x-auto">
  <nav class="isolate flex min-w-max divide-x divide-gray-200 rounded-lg shadow sm:min-w-0" aria-label="Tabs">
    <% tabs.each_with_index do |(label, url, active), i| %>
      <% active = (request.path == url) if active.nil? %>
      <a
        href="<%= url %>"
        class="group relative flex min-w-[11rem] flex-1 items-center justify-center overflow-hidden <%= (i == 0) ? "rounded-l-lg" : ((i == tabs.size - 1) ? "rounded-r-lg" : "") %> bg-white px-4 py-4 text-center text-sm font-medium focus:z-10 sm:min-w-0 <%= active ? "text-layerrail-600 hover:bg-layerrail-50 hover:text-layerrail-700" : "text-gray-500 hover:bg-layerrail-50 hover:text-layerrail-500" %>"
      >
        <span class="whitespace-nowrap"><%= label %></span>
        <span aria-hidden="true" class="absolute inset-x-0 bottom-0 h-0.5 <%= active ? "bg-layerrail-600" : "bg-transparent" %>"></span>
      </a>
    <% end %>
  </nav>
</div>
