<% @page_title = "AI Apps" %>
<%== render("components/free_quota") %>
<%== render("inference/tabbar") %>

<div class="grid gap-4 lg:grid-cols-[minmax(0,1.15fr)_minmax(320px,0.85fr)]">
  <div class="grid gap-4 content-start">
    <div class="overflow-hidden rounded-lg bg-white shadow ring-1 ring-black ring-opacity-5">
      <div class="p-5 sm:p-6">
        <div class="flex items-start gap-4">
          <div class="flex h-12 w-12 shrink-0 items-center justify-center rounded-lg bg-layerrail-600 text-white">
            <%== part("components/icon", name: "hero-sparkles", classes: "h-7 w-7") %>
          </div>
          <div class="min-w-0">
            <p class="text-sm font-semibold uppercase tracking-wide text-layerrail-600">Next Layer</p>
            <h1 class="mt-1 text-2xl font-bold tracking-tight text-gray-950 sm:text-3xl">Build AI apps developers can call from their products.</h1>
            <p class="mt-3 max-w-3xl text-sm leading-6 text-gray-600">
              Create a managed agent, attach a knowledge base, and expose it through a stable LayerRail API endpoint. Raw models stay available, but AI Apps gives your product a ready layer for support assistants, docs search, and workflow copilots.
            </p>
          </div>
        </div>
      </div>
      <div class="grid border-t border-gray-200 bg-gray-50 sm:grid-cols-4">
        <% [
          ["Agents", @ai_agents.length],
          ["Knowledge bases", @ai_knowledge_bases.length],
          ["API keys", @inference_api_keys.length],
          ["Templates", @ai_app_templates.length],
        ].each do |label, value| %>
          <div class="border-b border-gray-200 px-5 py-4 last:border-b-0 sm:border-b-0 sm:border-r sm:last:border-r-0">
            <p class="text-sm text-gray-500"><%= label %></p>
            <p class="mt-1 text-2xl font-semibold text-layerrail-600"><%= value %></p>
          </div>
        <% end %>
      </div>
    </div>

    <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black ring-opacity-5 sm:p-6">
      <div class="md:flex md:items-start md:justify-between md:gap-6">
        <div>
          <h2 class="text-lg font-semibold text-gray-950">Create an AI app</h2>
          <p class="mt-1 text-sm leading-6 text-gray-600">Pick a template, choose a model, optionally attach project knowledge, then call it from any product using your inference API key.</p>
        </div>
      </div>

      <% if @ai_app_text_models.empty? %>
        <div class="mt-5 rounded-md bg-yellow-50 p-4 text-sm text-yellow-800">
          No text generation model is currently enabled for AI Apps.
        </div>
      <% else %>
        <% form(action: "#{@project.path}/ai-app", method: :post, class: "mt-6 grid gap-5") do %>
          <div class="grid gap-5 sm:grid-cols-2">
            <%== render("components/form/text", locals: {name: "name", label: "App name", attributes: {"placeholder" => "support-agent"}}) %>
            <%== render("components/form/text", locals: {name: "public_slug", label: "Endpoint slug", attributes: {"placeholder" => "support-agent"}}) %>
          </div>
          <div class="grid gap-5 sm:grid-cols-2">
            <%== render("components/form/select", locals: {
              name: "template",
              label: "Template",
              options: @ai_app_templates.map { [it[:id], it[:name]] },
              selected: @ai_app_templates.first[:id],
            }) %>
            <%== render("components/form/select", locals: {
              name: "model_name",
              label: "Model",
              options: @ai_app_text_models.map { [it.model_name, it.tags["display_name"] || it.model_name] },
              selected: @ai_app_text_models.first.model_name,
            }) %>
          </div>
          <%== render("components/form/select", locals: {
            name: "knowledge_base_id",
            label: "Knowledge base",
            placeholder: "No knowledge base",
            options: @ai_knowledge_bases.map { [it.ubid, "#{it.name} (#{it.document_count} docs)"] },
          }) %>
          <%== render("components/form/text", locals: {name: "description", label: "Description", attributes: {"placeholder" => "Answers docs and support questions for customers"}}) %>
          <%== render("components/form/textarea", locals: {
            name: "system_prompt",
            label: "System prompt",
            description: "Leave blank to use the selected template prompt.",
            attributes: {"rows" => 4, "placeholder" => "You are a concise product assistant..."},
          }) %>
          <div class="flex justify-end">
            <%== part("components/form/submit_button", text: "Create AI App") %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%== part(
      "components/table_card",
      title: "AI Apps",
      headers: ["Name", "Model", "Knowledge", "Endpoint"],
      empty_state: {
        icon: "hero-sparkles",
        title: "No AI apps yet",
        description: "Create your first AI app to expose a managed agent endpoint for developers."
      },
      allow_wrap: true,
      rows: @ai_agents.map do |agent|
        [
          [
            [agent.name, {link: path(agent)}],
            agent.model_name,
            agent.knowledge_base ? agent.knowledge_base.name : "No knowledge base",
            [agent.public_url, {copyable: true}]
          ],
          {id: "agent-#{agent.ubid}"}
        ]
      end
    ) %>
  </div>

  <div class="grid gap-4 content-start">
    <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black ring-opacity-5 sm:p-6">
      <h2 class="text-lg font-semibold text-gray-950">Knowledge bases</h2>
      <p class="mt-1 text-sm leading-6 text-gray-600">Store docs, policies, support answers, or product data that AI Apps can retrieve at request time.</p>

      <% form(action: "#{@project.path}/ai-app/knowledge-base", method: :post, class: "mt-5 grid gap-4") do %>
        <%== render("components/form/text", locals: {name: "name", label: "Name", attributes: {"placeholder" => "product-docs"}}) %>
        <%== render("components/form/text", locals: {name: "description", label: "Description", attributes: {"placeholder" => "Public docs and support notes"}}) %>
        <div class="flex justify-end">
          <%== part("components/form/submit_button", text: "Create Knowledge Base") %>
        </div>
      <% end %>
    </div>

    <% @ai_knowledge_bases.each do |kb| %>
      <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black ring-opacity-5 sm:p-6">
        <div class="flex items-start justify-between gap-3">
          <div>
            <h3 class="text-base font-semibold text-gray-950"><%= kb.name %></h3>
            <p class="mt-1 text-sm text-gray-500"><%= kb.description.empty? ? "No description" : kb.description %></p>
          </div>
          <span class="shrink-0 rounded-full bg-layerrail-50 px-2 py-1 text-xs font-medium text-layerrail-700"><%= kb.document_count %> docs</span>
        </div>
        <% form(action: "#{@project.path}/ai-app/knowledge-base/#{kb.ubid}/document", method: :post, class: "mt-5 grid gap-4") do %>
          <div class="grid gap-4 sm:grid-cols-2">
            <%== render("components/form/text", locals: {name: "title", label: "Document title", attributes: {"placeholder" => "Getting started"}}) %>
            <%== render("components/form/select", locals: {
              name: "source_type",
              label: "Source type",
              options: [["text", "Text"], ["url", "URL"], ["api", "API"]],
              selected: "text",
            }) %>
          </div>
          <%== render("components/form/text", locals: {name: "source_url", label: "Source URL", attributes: {"placeholder" => "https://docs.example.com/page"}}) %>
          <%== render("components/form/textarea", locals: {
            name: "content",
            label: "Content",
            attributes: {"rows" => 5, "placeholder" => "Paste the knowledge this AI app should use..."},
          }) %>
          <div class="flex justify-end">
            <%== part("components/form/submit_button", text: "Add Document") %>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="rounded-lg bg-layerrail-50 p-5 ring-1 ring-layerrail-200">
      <h2 class="text-base font-semibold text-layerrail-900">Developer API</h2>
      <p class="mt-2 text-sm leading-6 text-layerrail-800">
        Agents use the same inference API keys as AI Models. Send a message to an agent endpoint and LayerRail adds the selected system prompt and project knowledge before calling the model.
      </p>
      <pre class="mt-4 overflow-x-auto rounded-lg bg-gray-900 p-3 text-xs text-white">curl <%= Config.base_url.chomp("/") %>/ai/v1/agents/&lt;agent-id&gt;/messages \
  -H "Content-Type: application/json" \
  -H "Authorization: Bearer $INFERENCE_API_KEY" \
  -d '{"message":"How do I deploy this?"}'</pre>
    </div>
  </div>
</div>
