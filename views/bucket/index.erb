<% @page_title = "Buckets" %>

<%== part(
  "components/page_header",
  title: "Buckets",
  breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Buckets", "#"]],
  right_items: [part("components/button", text: "Create Bucket", link: "#{@project.path}/bucket/create", icon: "hero-plus")]
) %>

<div class="grid gap-6">
  <% if @buckets.empty? %>
    <div class="rounded-lg bg-white p-12 text-center shadow">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-layerrail-50 text-layerrail-600">
        <%== part("components/icon", name: "hero-circle-stack", classes: "h-6 w-6") %>
      </div>
      <h3 class="mt-4 text-sm font-semibold text-gray-900">No buckets yet</h3>
      <p class="mt-1 text-sm text-gray-500">Create an S3-compatible bucket for app assets, backups, logs, and user uploads.</p>
      <div class="mt-6">
        <%== part("components/button", text: "Create Bucket", link: "#{@project.path}/bucket/create", icon: "hero-plus") %>
      </div>
    </div>
  <% else %>
    <%== part(
      "components/table_card",
      headers: ["Name", "Location", "Endpoint", "State", "Created"],
      rows: @buckets.map do |bucket|
        [
          [
            [bucket.name, {link: "#{@project.path}#{bucket.path}"}],
            [bucket.display_location],
            [bucket.endpoint || "Provisioning"],
            [bucket.state],
            [bucket.created_at.utc.strftime("%b %-d, %Y")]
          ],
          {id: "bucket-#{bucket.ubid}"}
        ]
      end
    ) %>
  <% end %>
</div>
