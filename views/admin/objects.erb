<% @page_title = @klass.name %>

<% if @objects.empty? %>
  <p class="empty-state">No <%= @klass.name %> records found.</p>
<% else %>
  <ul id="object-list">
    <% @objects.each do |object| %>
      <li><a href="/model/<%= @klass %>/<%= object.ubid %>"><%= object.admin_label %></a></li>
    <% end %>
  </ul>
<% end %>

<% if @after %>
  <p><a href="?after=<%= @after %>">More</a></p>
<% end %>
