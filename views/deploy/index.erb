<% @page_title = "Deploy" %>
<div class="auto-refresh hidden" data-interval="10"></div>

<% live_count = @deploy_apps.count { it.display_state == "live" } %>
<% failed_count = @deploy_apps.count { it.display_state == "failed" } %>
<% active_builds = @deploy_apps.count { %w[provisioning deploying].include?(it.display_state) } %>

<%== part(
  "components/page_header",
  breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Deploy", "#"]],
  right_items: has_project_permission("Vm:create") ? [part("components/button", text: "Import Project", link: "#{@project.path}/deploy/create", icon: "hero-cloud-arrow-up")] : []
) %>

<%== render("deploy/tabbar", locals: {active: "projects"}) %>

<style>
  @keyframes deploy-flow {
    0% { transform: translateX(-35%); opacity: .2; }
    45% { opacity: 1; }
    100% { transform: translateX(135%); opacity: .2; }
  }

  @keyframes deploy-pulse {
    0%, 100% { transform: scale(.86); opacity: .45; }
    50% { transform: scale(1); opacity: 1; }
  }

  .deploy-flow-fill {
    animation: deploy-flow 2.8s ease-in-out infinite;
  }

  .deploy-pulse {
    animation: deploy-pulse 1.8s ease-in-out infinite;
  }
</style>

<div class="grid gap-6">
  <section class="overflow-hidden rounded-lg bg-gray-950 shadow ring-1 ring-black ring-opacity-5">
    <div class="grid gap-0 lg:grid-cols-[1fr_440px]">
      <div class="p-6 sm:p-8">
        <div class="flex items-center gap-3">
          <div class="flex h-10 w-10 items-center justify-center rounded-md bg-emerald-400 text-gray-950">
            <%== part("components/icon", name: "hero-cloud-arrow-up", classes: "h-5 w-5") %>
          </div>
          <div>
            <p class="text-sm font-semibold text-emerald-200">LayerRail Deploy</p>
            <h2 class="mt-1 text-2xl font-semibold tracking-normal text-white">Git push to production compute</h2>
          </div>
        </div>
        <p class="mt-4 max-w-2xl text-sm leading-6 text-gray-300">
          Imports, builds, runtime networking, DNS, and deploy logs stay in one place so every release has a clear path from source to live traffic.
        </p>
        <div class="mt-6 flex flex-wrap gap-3 text-xs font-semibold uppercase tracking-normal text-gray-300">
          <span class="rounded-full border border-white/10 px-3 py-1">Source</span>
          <span class="rounded-full border border-white/10 px-3 py-1">Build</span>
          <span class="rounded-full border border-white/10 px-3 py-1">Runtime</span>
          <span class="rounded-full border border-white/10 px-3 py-1">Domains</span>
        </div>
      </div>
      <div class="relative min-h-[220px] overflow-hidden bg-gray-900 p-8">
        <div class="absolute inset-0" style="background-image: linear-gradient(90deg, rgba(255,255,255,.05) 1px, transparent 1px), linear-gradient(0deg, rgba(255,255,255,.04) 1px, transparent 1px); background-size: 36px 36px;"></div>
        <div class="relative flex h-full items-center justify-between gap-4">
          <% [["Git", "github", "bg-white text-gray-950"], ["Build", "hero-cog-6-tooth", "bg-sky-300 text-gray-950"], ["Live", "hero-sparkles", "bg-emerald-300 text-gray-950"]].each_with_index do |(label, icon, classes), index| %>
            <div class="relative z-10 flex h-24 w-24 flex-col items-center justify-center rounded-lg <%= classes %> shadow-2xl shadow-black/30 <%= index == 1 ? "deploy-pulse" : "" %>">
              <%== part("components/icon", name: icon, classes: "h-6 w-6") %>
              <span class="mt-2 text-xs font-bold"><%= label %></span>
            </div>
            <% unless index == 2 %>
              <div class="relative h-px flex-1 overflow-hidden bg-white/20">
                <span class="deploy-flow-fill absolute inset-y-0 left-0 w-1/2 bg-emerald-300"></span>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black ring-opacity-5">
      <div class="text-sm font-medium text-gray-500">Live apps</div>
      <div class="mt-2 text-3xl font-semibold text-gray-900"><%= live_count %></div>
    </div>
    <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black ring-opacity-5">
      <div class="text-sm font-medium text-gray-500">Building now</div>
      <div class="mt-2 text-3xl font-semibold text-gray-900"><%= active_builds %></div>
    </div>
    <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black ring-opacity-5">
      <div class="text-sm font-medium text-gray-500">Needs attention</div>
      <div class="mt-2 text-3xl font-semibold text-gray-900"><%= failed_count %></div>
    </div>
  </div>

  <%== part(
    "components/table_card",
    title: "Projects",
    headers: ["Project", "Source", "Production", "Runtime", "State"],
    rows: @deploy_apps.map do |app|
      latest = app.latest_deployment
      [
        [
          [
            [app.name, {link: path(app)}],
            [app.ubid, {copyable: true}]
          ],
          [
            [app.repository, {link: app.repository_url}],
            ["#{app.branch} branch", {}]
          ],
          [app.public_hostname, {copyable: true}],
          [
            [app.framework_label, {}],
            [app.location.ui_name, {}]
          ],
          [
            ["deploy_state_label", {component: {state: app.display_state}}],
            [latest ? "Last deploy: #{latest.created_at.strftime("%F %T")}" : "No deployment yet", {}]
          ]
        ],
        {id: "deploy-app-#{app.ubid}"}
      ]
    end,
    empty_state: {
      icon: "hero-cloud-arrow-up",
      title: "No deploy projects yet",
      description: has_project_permission("Vm:create") ? "Import a GitHub repository, configure the build, and ship it on LayerRail-managed compute." : "You don't have permission to create deploy projects.",
      button_link: (has_project_permission("Vm:create") ? "#{@project.path}/deploy/create" : nil),
      button_title: (has_project_permission("Vm:create") ? "Import Project" : nil)
    }
  ) %>
</div>
