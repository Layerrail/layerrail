<% @page_title = @deploy_app.name %>
<div class="auto-refresh hidden" data-interval="10"></div>

<% latest = @deploy_app.latest_deployment %>
<% right_items = [part("components/deploy_state_label", state: @deploy_app.display_state, extra_class: "text-md")]
if has_permission?("Vm:create", @project) && !%w[provisioning deploying deleting].include?(@deploy_app.display_state)
  right_items << form({action: "#{path(@deploy_app)}/deploy", method: :post}, emit: false) do |f|
    f << part("components/button", text: "Redeploy", icon: "hero-rocket-launch")
  end
end %>

<%== part(
  "components/page_header",
  breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Deploy", "#{@project.path}/deploy"], [@deploy_app.name, "#"]],
  right_items:
) %>

<% active_tab = @deploy_tab || "overview" %>
<%== render("deploy/tabbar", locals: {active: active_tab, app: @deploy_app}) %>

<div class="grid gap-6">
  <% if active_tab == "overview" %>
    <section class="grid gap-4 lg:grid-cols-4">
      <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black ring-opacity-5">
        <div class="text-sm font-medium text-gray-500">Production URL</div>
        <div class="mt-2 truncate text-sm font-semibold text-gray-900"><%== part("components/copyable_content", content: @deploy_app.public_hostname) %></div>
        <a class="mt-3 inline-flex text-sm font-medium text-layerrail-600 hover:text-layerrail-700" href="<%= @deploy_app.public_url %>" target="_blank" rel="noopener">Open site</a>
      </div>
      <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black ring-opacity-5">
        <div class="text-sm font-medium text-gray-500">Source</div>
        <a class="mt-2 block truncate text-sm font-semibold text-layerrail-600 hover:text-layerrail-700" href="<%= @deploy_app.repository_url %>" target="_blank" rel="noopener"><%= @deploy_app.repository %></a>
        <div class="mt-1 text-xs text-gray-500"><%= @deploy_app.branch %></div>
      </div>
      <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black ring-opacity-5">
        <div class="text-sm font-medium text-gray-500">Runtime</div>
        <div class="mt-2 text-sm font-semibold text-gray-900"><%= @deploy_app.framework_label %></div>
        <div class="mt-1 text-xs text-gray-500"><%= @deploy_app.environment.capitalize %> / <%= @deploy_app.location.ui_name %></div>
      </div>
      <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black ring-opacity-5">
        <div class="text-sm font-medium text-gray-500">Latest deploy</div>
        <div class="mt-2 text-sm font-semibold text-gray-900"><%= latest ? latest.created_at.strftime("%F %T") : "None" %></div>
        <div class="mt-1 text-xs text-gray-500"><%= latest ? latest.trigger.tr("_", " ") : "-" %></div>
      </div>
    </section>

    <% if @deploy_app.failure_message %>
      <div class="rounded-lg bg-red-50 p-4 text-sm text-red-800 ring-1 ring-red-200">
        <%= @deploy_app.failure_message %>
      </div>
    <% end %>
  <% end %>

  <% if active_tab == "deployments" %>
    <%== part(
      "components/table_card",
      title: "Deployments",
      headers: ["Started", "Trigger", "Commit", "Image", "State", "Finished", ""],
      rows: @deployments.map do |deployment|
        rollback = if deployment.status == "live" && !deployment.image_ref.to_s.empty? && has_permission?("Vm:create", @project)
          form({action: "#{path(@deploy_app)}/rollback/#{deployment.ubid}", method: :post}, emit: false) do |f|
            f << part("components/button", text: "Rollback", icon: "hero-arrow-path", extra_class: "py-1.5")
          end
        end
        [
          [
            deployment.created_at.strftime("%F %T"),
            deployment.trigger.tr("_", " "),
            [
              [deployment.commit_sha.to_s.empty? ? "-" : deployment.commit_sha[0, 12], {}],
              [deployment.commit_message.to_s.empty? ? deployment.source_ref : deployment.commit_message.lines.first.to_s.strip, {}]
            ],
            [deployment.image_ref.to_s.empty? ? "-" : deployment.image_ref.split(":").last, {copyable: true}],
            ["deploy_state_label", {component: {state: deployment.display_state}}],
            deployment.finished_at&.strftime("%F %T") || "-",
            [rollback, {escape: false}]
          ],
          {id: "deployment-#{deployment.ubid}"}
        ]
      end,
      empty_state: "No deployments yet."
    ) %>
  <% end %>

  <% if active_tab == "domains" %>
  <section class="grid gap-6 lg:grid-cols-[1fr_360px]">
    <%== part(
      "components/table_card",
      title: "Domains",
      headers: ["Domain", "State", "DNS", "Auto-renew"],
      rows: @deploy_domains.map do |domain|
        [
          [
            [[domain.domain, {link: path(domain)}], [domain.ubid, {copyable: true}]],
            domain.display_state,
            domain.project_attachment_label,
            domain.auto_renew ? "On" : "Off"
          ],
          {id: "deploy-domain-#{domain.ubid}"}
        ]
      end,
      empty_state: "No domains attached to this app."
    ) %>

    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
      <h2 class="text-base font-semibold text-gray-900">Attach Domain</h2>
      <% if @available_domains.any? %>
        <% form(action: "#{path(@deploy_app)}/domain", method: :post, class: "mt-5 space-y-4") do %>
          <%== part(
            "components/form/select",
            name: "domain_registration_id",
            label: "Domain",
            options: @available_domains.map { [it.ubid, it.domain] },
            attributes: {required: "required"}
          ) %>
          <div class="flex flex-wrap justify-end gap-3">
            <%== part("components/form/submit_button", text: "Attach", icon: "hero-check") %>
          </div>
        <% end %>
      <% else %>
        <div class="mt-5 rounded-lg bg-gray-50 p-4 text-sm text-gray-600">
          Active domains will appear here after registration or transfer.
        </div>
        <div class="mt-5">
          <%== part("components/button", text: "Register Domain", link: "#{@project.path}/domain/create", icon: "hero-globe-alt") %>
        </div>
      <% end %>
    </div>
  </section>
  <% end %>

  <% if active_tab == "environment" %>
  <section class="grid gap-6 lg:grid-cols-[1fr_360px]">
    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
      <h2 class="text-base font-semibold text-gray-900">Environment Variables</h2>
      <div class="mt-5 divide-y divide-gray-100">
        <% if @deploy_app.variables.empty? %>
          <div class="rounded-lg bg-gray-50 p-4 text-sm text-gray-600">No variables configured.</div>
        <% end %>
        <% @deploy_app.variables.each do |variable| %>
          <div class="flex items-center justify-between gap-3 py-3 text-sm">
            <span class="font-medium text-gray-900"><%= variable.key %></span>
            <% form(action: "#{path(@deploy_app)}/variable-delete/#{variable.ubid}", method: :post) do %>
              <button class="rounded-md px-2 py-1 text-sm font-semibold text-red-600 hover:bg-red-50">Delete</button>
            <% end %>
          </div>
        <% end %>
      </div>
    </div>

    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
      <h2 class="text-base font-semibold text-gray-900">Add Variable</h2>
      <% form(action: "#{path(@deploy_app)}/variable", method: :post, class: "mt-5 space-y-4") do %>
        <%== part("components/form/text", name: "key", label: "Key", attributes: {placeholder: "DATABASE_URL", autocomplete: "off"}) %>
        <%== part("components/form/text", name: "value", label: "Value", attributes: {placeholder: "secret value", autocomplete: "off"}) %>
        <div class="flex justify-end">
          <%== part("components/form/submit_button", text: "Save", icon: "hero-check") %>
        </div>
      <% end %>
    </div>
  </section>
  <% end %>

  <% if active_tab == "deployments" && latest&.log %>
    <section class="rounded-lg bg-gray-900 p-4 shadow ring-1 ring-black ring-opacity-5" id="logs">
      <div class="mb-3 flex items-center justify-between">
        <h2 class="text-base font-semibold leading-6 text-white">Latest Log</h2>
        <%== part("components/deploy_state_label", state: latest.display_state) %>
      </div>
      <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-words text-xs leading-5 text-gray-100"><%= latest.log_excerpt %></pre>
    </section>
  <% end %>

  <% if active_tab == "settings" %>
  <section class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5 lg:col-span-2">
      <h2 class="text-base font-semibold text-gray-900">Build and Runtime</h2>
      <% form(action: "#{path(@deploy_app)}/settings", method: :post, class: "mt-5 grid gap-5 md:grid-cols-6") do %>
        <div class="md:col-span-3">
          <%== part(
            "components/form/select",
            name: "framework",
            label: "Build pack",
            selected: @deploy_app.framework,
            options: DeployApp::BUILD_PACKS.map { [it[:key], it[:label]] },
            attributes: {required: "required"}
          ) %>
        </div>
        <div class="md:col-span-3">
          <%== part("components/form/text", name: "branch", label: "Production branch", value: @deploy_app.branch, attributes: {required: "required", autocomplete: "off"}) %>
        </div>
        <div class="md:col-span-3">
          <%== part("components/form/text", name: "root_directory", label: "Root directory", value: @deploy_app.root_directory, attributes: {placeholder: "apps/web", autocomplete: "off"}) %>
        </div>
        <div class="md:col-span-3">
          <%== part("components/form/text", name: "output_directory", label: "Output directory", value: @deploy_app.output_directory, attributes: {placeholder: "dist", autocomplete: "off"}) %>
        </div>
        <div class="md:col-span-3">
          <%== part("components/form/text", name: "install_command", label: "Install command", value: @deploy_app.install_command, attributes: {autocomplete: "off"}) %>
        </div>
        <div class="md:col-span-3">
          <%== part("components/form/text", name: "build_command", label: "Build command", value: @deploy_app.build_command, attributes: {autocomplete: "off"}) %>
        </div>
        <div class="md:col-span-5">
          <%== part("components/form/text", name: "start_command", label: "Start command", value: @deploy_app.start_command, attributes: {autocomplete: "off"}) %>
        </div>
        <div class="md:col-span-1">
          <%== part("components/form/text", name: "app_port", label: "Port", type: "number", value: @deploy_app.app_port, attributes: {required: "required", min: 1, max: 65535}) %>
        </div>
        <div class="md:col-span-3">
          <%== part(
            "components/form/checkbox",
            name: "auto_deploy",
            label: "Automation",
            options: [["true", "Deploy production automatically from GitHub pushes and open pull request previews.", "", @deploy_app.auto_deploy ? {checked: "checked"} : {}]]
          ) %>
        </div>
        <div class="md:col-span-3">
          <%== part(
            "components/form/checkbox",
            name: "build_cache_enabled",
            label: "Build cache",
            options: [["true", "Reuse the latest image layers to make repeat deployments faster.", "", @deploy_app.build_cache_enabled ? {checked: "checked"} : {}]]
          ) %>
        </div>
        <div class="md:col-span-6 flex justify-end">
          <%== part("components/form/submit_button", text: "Save Settings", icon: "hero-check") %>
        </div>
      <% end %>
    </div>

    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
      <h2 class="text-base font-semibold text-gray-900">Source</h2>
      <dl class="mt-5 space-y-4 text-sm">
        <div>
          <dt class="text-gray-500">Repository</dt>
          <dd class="mt-1 truncate font-medium text-layerrail-600"><a href="<%= @deploy_app.repository_url %>" target="_blank" rel="noopener"><%= @deploy_app.repository %></a></dd>
        </div>
        <div>
          <dt class="text-gray-500">GitHub account</dt>
          <dd class="mt-1 font-medium text-gray-900"><%= @deploy_app.installation.name %></dd>
        </div>
        <div>
          <dt class="text-gray-500">Production host</dt>
          <dd class="mt-1 truncate font-medium text-gray-900"><%== part("components/copyable_content", content: @deploy_app.public_hostname) %></dd>
        </div>
        <div>
          <dt class="text-gray-500">Runtime size</dt>
          <dd class="mt-1 font-medium text-gray-900"><%= @deploy_app.vm_size %></dd>
        </div>
      </dl>
    </div>

    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
      <h2 class="text-base font-semibold text-gray-900">Danger Zone</h2>
      <div class="mt-5">
        <%== part(
          "components/delete_button",
          text: "Delete Project",
          url: path(@deploy_app),
          confirmation: @deploy_app.name,
          confirmation_message: "Deleting this deploy app also deletes its managed runtime.",
        ) if has_permission?("Vm:delete", @project) && !@deploy_app.display_state.start_with?("deleting") %>
      </div>
    </div>
  </section>
  <% end %>
</div>
