<% @page_title = @deploy_app.name %>
<div class="auto-refresh hidden" data-interval="10"></div>

<% right_items = [part("components/deploy_state_label", state: @deploy_app.display_state, extra_class: "text-md")]
if has_permission?("Vm:create", @project) && !%w[provisioning deploying deleting].include?(@deploy_app.display_state)
  right_items << form({action: "#{path(@deploy_app)}/deploy", method: :post}, emit: false) do |f|
    f << part("components/button", text: "Deploy", icon: "hero-rocket-launch")
  end
end
right_items << part(
  "components/delete_button",
  text: "Delete",
  url: path(@deploy_app),
  confirmation: @deploy_app.name,
  confirmation_message: "Deleting this deploy app also deletes its LayerRail VM.",
) if has_permission?("Vm:delete", @project) && !@deploy_app.display_state.start_with?("deleting") %>

<%== part(
  "components/page_header",
  breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Deploy", "#{@project.path}/deploy"], [@deploy_app.name, "#"]],
  right_items:
) %>

<div class="grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
    <h3 class="text-base font-semibold leading-6 text-gray-900">App</h3>
    <dl class="mt-4 space-y-3 text-sm">
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">URL</dt>
        <dd class="font-medium text-gray-900"><%== part("components/copyable_content", content: @deploy_app.public_hostname) %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">Repository</dt>
        <dd class="font-medium text-layerrail-600"><a href="<%= @deploy_app.repository_url %>"><%= @deploy_app.repository %></a></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">Branch</dt>
        <dd class="font-medium text-gray-900"><%= @deploy_app.branch %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">Runtime</dt>
        <dd class="font-medium text-gray-900"><%= @deploy_app.framework_label %></dd>
      </div>
    </dl>
  </div>

  <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
    <h3 class="text-base font-semibold leading-6 text-gray-900">Compute</h3>
    <dl class="mt-4 space-y-3 text-sm">
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">Location</dt>
        <dd class="font-medium text-gray-900"><%= @deploy_app.location.ui_name %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">VM size</dt>
        <dd class="font-medium text-gray-900"><%= @deploy_app.vm_size %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">VM</dt>
        <dd class="font-medium text-gray-900">
          <% if @deploy_app.vm %>
            <a class="text-layerrail-600" href="<%= path(@deploy_app.vm) %>"><%= @deploy_app.vm.name %></a>
          <% else %>
            Not assigned yet
          <% end %>
        </dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">IP address</dt>
        <dd class="font-medium text-gray-900"><%== part("components/copyable_content", content: @deploy_app.vm&.ip4_string || "Not assigned yet") %></dd>
      </div>
    </dl>
  </div>

  <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
    <h3 class="text-base font-semibold leading-6 text-gray-900">Build</h3>
    <dl class="mt-4 space-y-3 text-sm">
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">Root</dt>
        <dd class="font-medium text-gray-900"><%= @deploy_app.root_directory.empty? ? "/" : @deploy_app.root_directory %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">Install</dt>
        <dd class="font-medium text-gray-900 text-right"><%= @deploy_app.install_command %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">Build</dt>
        <dd class="font-medium text-gray-900 text-right"><%= @deploy_app.build_command || "-" %></dd>
      </div>
      <div class="flex justify-between gap-4">
        <dt class="text-gray-500">Start</dt>
        <dd class="font-medium text-gray-900 text-right"><%= @deploy_app.start_command || "-" %></dd>
      </div>
    </dl>
  </div>
</div>

<% if @deploy_app.failure_message %>
  <div class="mt-6 rounded-lg bg-red-50 p-4 text-sm text-red-800 ring-1 ring-red-200">
    <%= @deploy_app.failure_message %>
  </div>
<% end %>

<div class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-3">
  <div class="lg:col-span-2">
    <%== part(
      "components/table_card",
      title: "Deployments",
      headers: ["Created", "Trigger", "State", "Finished"],
      rows: @deployments.map do |deployment|
        [
          [
            deployment.created_at.strftime("%F %T"),
            deployment.trigger,
            ["deploy_state_label", {component: {state: deployment.display_state}}],
            deployment.finished_at&.strftime("%F %T") || "-"
          ],
          {id: "deployment-#{deployment.ubid}"}
        ]
      end,
      empty_state: "No deployments yet."
    ) %>
  </div>

  <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
    <h3 class="text-base font-semibold leading-6 text-gray-900">Environment</h3>
    <div class="mt-4 space-y-3">
      <% @deploy_app.variables.each do |variable| %>
        <div class="flex items-center justify-between gap-3 rounded-md bg-gray-50 px-3 py-2 text-sm">
          <span class="font-medium text-gray-900"><%= variable.key %></span>
          <% form(action: "#{path(@deploy_app)}/variable-delete/#{variable.ubid}", method: :post) do %>
            <button class="text-sm font-semibold text-red-600">Delete</button>
          <% end %>
        </div>
      <% end %>
      <% form(action: "#{path(@deploy_app)}/variable", method: :post) do %>
        <div class="grid grid-cols-1 gap-3">
          <%== part("components/form/text", name: "key", label: "Key", attributes: {placeholder: "DATABASE_URL"}) %>
          <%== part("components/form/text", name: "value", label: "Value", attributes: {placeholder: "secret value"}) %>
          <%== part("components/form/submit_button", text: "Save variable") %>
        </div>
      <% end %>
    </div>
  </div>
</div>

<% if (latest = @deploy_app.latest_deployment)&.log %>
  <div class="mt-6 rounded-lg bg-gray-900 p-4 shadow ring-1 ring-black ring-opacity-5">
    <div class="mb-3 flex items-center justify-between">
      <h3 class="text-base font-semibold leading-6 text-white">Latest deployment log</h3>
      <%== part("components/deploy_state_label", state: latest.display_state) %>
    </div>
    <pre class="max-h-96 overflow-auto whitespace-pre-wrap break-words text-xs leading-5 text-gray-100"><%= latest.log_excerpt %></pre>
  </div>
<% end %>
