<% @page_title = "GitHub Runners" %>

<%== part(
  "components/page_header",
  title: "GitHub Runners",
  breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["GitHub Runners", "#"]]
) %>

<% if !@project.has_valid_payment_method? %>
  <% form(action: billing_path, method: :post) do %>
    <%== part(
      "components/empty_state",
      icon: "hero-banknotes",
      title: "Billing is required",
      description: "Add billing before enabling managed GitHub Actions runners. Runner usage is billed by size and runtime.",
      button_title: "Add Billing"
    ) %>
  <% end %>
<% else %>
  <div class="grid gap-6 lg:grid-cols-3">
    <section class="rounded-lg bg-white p-6 shadow ring-1 ring-black/5 lg:col-span-2">
      <div class="flex items-center gap-3">
        <%== part("components/icon", name: "github", classes: "h-8 w-8 text-gray-950") %>
        <div>
          <h2 class="text-xl font-semibold text-gray-950">Connect GitHub to start managed runners</h2>
          <p class="mt-1 text-sm text-gray-600">Install the LayerRail GitHub App, select repositories, then use LayerRail runner labels in your workflow files.</p>
        </div>
      </div>

      <div class="mt-6 grid gap-3 sm:grid-cols-3">
        <% [
          ["1", "Install GitHub App", "Choose the GitHub user or organization."],
          ["2", "Select repositories", "Allow only the repos that should use runners."],
          ["3", "Use runner labels", "Set runs-on to a LayerRail label and push."]
        ].each do |step, title, body| %>
          <div class="rounded-lg border border-gray-200 p-4">
            <div class="flex h-7 w-7 items-center justify-center rounded-full bg-layerrail-50 text-sm font-semibold text-layerrail-700"><%= step %></div>
            <h3 class="mt-3 text-sm font-semibold text-gray-950"><%= title %></h3>
            <p class="mt-1 text-sm text-gray-600"><%= body %></p>
          </div>
        <% end %>
      </div>

      <div class="mt-6 flex flex-wrap gap-3">
        <%== part("components/button", text: "Connect GitHub", link: "#{@project.path}/github/create", icon: "github") %>
        <%== part("components/button", text: "Finish Existing Install", link: "#{@project.path}/github/finish", icon: "hero-arrow-path") %>
      </div>
    </section>

    <aside class="rounded-lg bg-white p-6 shadow ring-1 ring-black/5">
      <h3 class="text-base font-semibold text-gray-950">Default labels</h3>
      <div class="mt-4 space-y-3 text-sm">
        <% [
          ["layerrail-standard-2", "2 vCPU, Ubuntu x64"],
          ["layerrail-standard-8", "8 vCPU, Ubuntu x64"],
          ["layerrail-standard-4-arm", "4 vCPU, Ubuntu ARM64"],
          ["layerrail-premium-4", "4 vCPU premium capacity"]
        ].each do |label, description| %>
          <div>
            <div class="font-mono text-xs font-semibold text-gray-950"><%= label %></div>
            <div class="mt-0.5 text-gray-500"><%= description %></div>
          </div>
        <% end %>
      </div>
    </aside>
  </div>
<% end %>
