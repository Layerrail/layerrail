<% @page_title = "Runner Settings" %>

<%== render("github/tabbar") %>

<div class="grid gap-6">
  <% unless Config.compute_provider == "linode" %>
    <section class="overflow-hidden rounded-lg bg-white shadow ring-1 ring-black/5 lg:flex">
      <div class="p-8 lg:flex-auto">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="text-2xl font-semibold tracking-tight text-gray-950">Premium capacity</h3>
          <% if @installation.premium_runner_enabled? %>
            <span class="rounded-full bg-layerrail-50 px-2.5 py-1 text-xs font-semibold text-layerrail-700">Enabled</span>
          <% end %>
        </div>
        <% if @installation.free_runner_upgrade? %>
          <div class="mt-3 inline-flex rounded-full bg-green-50 px-3 py-1 text-xs font-medium text-green-700">
            50% off premium runners until <%= @installation.free_runner_upgrade_expires_at.strftime("%B %d, %Y") %>
          </div>
        <% end %>
        <p class="mt-4 max-w-3xl text-sm leading-6 text-gray-600">
          Premium capacity lets eligible jobs start on faster runner machines first. If premium capacity is unavailable, jobs can still fall back to standard capacity so the workflow keeps moving.
        </p>
        <div class="mt-6 grid gap-3 text-sm text-gray-600 sm:grid-cols-2">
          <% [
            "Usage is billed by the runner type and runtime used.",
            "Standard labels continue to work normally.",
            "Premium labels can be enabled or disabled per installation.",
            "Cache allowance increases when premium capacity is enabled."
          ].each do |text| %>
            <div class="flex gap-3">
              <%== part("components/icon", name: "hero-check", classes: "h-5 w-5 shrink-0 text-layerrail-600") %>
              <span><%= text %></span>
            </div>
          <% end %>
        </div>
      </div>
      <div class="border-t border-gray-200 p-8 lg:w-80 lg:border-l lg:border-t-0">
        <div class="rounded-lg bg-gray-50 p-6 text-center ring-1 ring-inset ring-gray-900/5">
          <p class="text-sm font-medium text-gray-500">Runner preference</p>
          <p class="mt-2 text-2xl font-semibold text-gray-950"><%= @installation.premium_runner_enabled? ? "Premium first" : "Standard only" %></p>
          <div class="mt-5 flex justify-center">
            <%== part("components/form/toggle_form", name: "premium_runner_enabled", action: "#{@project.path}/github/#{@installation.ubid}/set-premium", active: @installation.premium_runner_enabled?) %>
          </div>
        </div>
      </div>
    </section>
  <% end %>

  <section class="overflow-hidden rounded-lg bg-white shadow ring-1 ring-black/5">
    <div class="divide-y divide-gray-200">
      <div class="px-6 py-5 sm:flex sm:items-center sm:justify-between">
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <h3 class="text-base font-semibold text-gray-950">Transparent cache</h3>
            <% if @installation.cache_enabled %>
              <span class="rounded-full bg-layerrail-50 px-2.5 py-1 text-xs font-semibold text-layerrail-700">Enabled</span>
            <% end %>
          </div>
          <p class="mt-1 text-sm text-gray-600">Accelerates repeated workflow jobs without requiring workflow-file changes.</p>
        </div>
        <div class="mt-4 sm:mt-0">
          <%== part("components/form/toggle_form", name: "cache_enabled", action: "#{@project.path}/github/#{@installation.ubid}/set-cache", active: @installation.cache_enabled) %>
        </div>
      </div>

      <% if @installation.cache_enabled %>
        <div class="px-6 py-5 sm:flex sm:items-center sm:justify-between">
          <div>
            <div class="flex flex-wrap items-center gap-2">
              <h3 class="text-base font-semibold text-gray-950">Cache branch protection</h3>
              <% if @installation.cache_scope_protected %>
                <span class="rounded-full bg-layerrail-50 px-2.5 py-1 text-xs font-semibold text-layerrail-700">Enabled</span>
              <% end %>
            </div>
            <p class="mt-1 text-sm text-gray-600">Limits cache access to the current branch, tag, or default branch.</p>
          </div>
          <div class="mt-4 sm:mt-0">
            <%== part("components/form/toggle_form", name: "cache_scope_protected", action: "#{@project.path}/github/#{@installation.ubid}/set-cache-scope", active: @installation.cache_scope_protected) %>
          </div>
        </div>
      <% end %>

      <div class="px-6 py-5 sm:flex sm:items-center sm:justify-between">
        <div>
          <h3 class="text-base font-semibold text-gray-950">Repository access</h3>
          <p class="mt-1 text-sm text-gray-600">Choose which repositories can request LayerRail runners from the GitHub installation page.</p>
        </div>
        <div id="configure-<%= @installation.ubid %>" class="mt-4 sm:mt-0">
          <%== part("components/button", text: "Open GitHub settings", link: "https://github.com/apps/#{Config.github_app_name}/installations/#{@installation.installation_id}", icon: "github") %>
        </div>
      </div>
    </div>
  </section>
</div>
