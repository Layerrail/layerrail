<% @page_title = "GitHub Runners" %>

<div class="auto-refresh hidden" data-interval="10"></div>

<%== render("github/tabbar") %>

<div class="grid gap-6">
  <section class="overflow-hidden rounded-lg bg-white shadow ring-1 ring-black/5">
    <div class="border-b border-gray-200 px-6 py-5">
      <div class="flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
        <div>
          <h2 class="text-xl font-semibold text-gray-950">Managed GitHub Actions runners</h2>
          <p class="mt-1 max-w-3xl text-sm text-gray-600">
            LayerRail starts an isolated runner when GitHub queues a matching job, connects it with a just-in-time token, then removes it after the job completes.
          </p>
        </div>
        <div class="flex flex-wrap gap-2">
          <%== part("components/button", text: "Configure GitHub", link: "https://github.com/apps/#{Config.github_app_name}/installations/#{@installation.installation_id}", icon: "github") %>
          <%== part("components/button", text: "Settings", link: "#{path(@installation)}/setting", icon: "hero-cog-6-tooth") %>
        </div>
      </div>
    </div>

    <dl class="grid grid-cols-2 divide-x divide-y divide-gray-200 md:grid-cols-4 md:divide-y-0">
      <% [
        ["Running jobs", @running_runners, "Active workflow jobs"],
        ["Ready runners", @ready_runners, "Waiting for GitHub"],
        ["Starting", @queued_runners, "Provisioning now"],
        ["Capacity waits", @waiting_for_capacity, "Quota or pool wait"]
      ].each do |title, value, subtitle| %>
        <div class="px-5 py-4">
          <dt class="text-sm font-medium text-gray-500"><%= title %></dt>
          <dd class="mt-2 text-3xl font-semibold text-gray-950"><%= value %></dd>
          <p class="mt-1 text-xs text-gray-500"><%= subtitle %></p>
        </div>
      <% end %>
    </dl>
  </section>

  <section class="grid gap-6 xl:grid-cols-3">
    <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black/5 xl:col-span-2">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h3 class="text-base font-semibold text-gray-950">Use these labels in GitHub Actions</h3>
          <p class="mt-1 text-sm text-gray-600">Choose a LayerRail label in your workflow. The backend handles the VM, registration, cache, and cleanup.</p>
        </div>
        <span class="rounded-full bg-layerrail-50 px-3 py-1 text-xs font-medium text-layerrail-700"><%= @runner_catalog.count %> labels</span>
      </div>

      <div class="mt-5 overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead>
            <tr class="text-left text-xs font-semibold uppercase tracking-wide text-gray-500">
              <th class="py-2 pr-4">Label</th>
              <th class="px-4 py-2">Family</th>
              <th class="px-4 py-2">CPU</th>
              <th class="px-4 py-2">Arch</th>
              <th class="px-4 py-2">Disk</th>
              <th class="px-4 py-2">Image</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @runner_catalog.each do |label| %>
              <tr>
                <td class="py-3 pr-4 font-mono text-xs font-semibold text-gray-950"><%= label["name"] %></td>
                <td class="px-4 py-3">
                  <span class="rounded-md px-2 py-1 text-xs font-medium <%= label["family"] == "premium" ? "bg-layerrail-50 text-layerrail-700" : "bg-gray-100 text-gray-700" %>"><%= label["family"] %></span>
                </td>
                <td class="px-4 py-3 text-gray-700"><%= label["vcpus"] %> vCPU</td>
                <td class="px-4 py-3 text-gray-700"><%= label["arch"] %></td>
                <td class="px-4 py-3 text-gray-700"><%= label["storage_size_gib"] %> GB</td>
                <td class="px-4 py-3 text-gray-700"><%= label["boot_image"].sub("github-", "").tr("-", " ") %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>

    <div class="grid gap-6">
      <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black/5">
        <h3 class="text-base font-semibold text-gray-950">Usage</h3>
        <dl class="mt-4 grid grid-cols-2 gap-4">
          <% [
            ["Allocated", "#{@allocated_vcpus} vCPU"],
            ["Requested", "#{@requested_vcpus} vCPU"],
            ["Today", money(@today_usage)],
            ["30 days", money(@last_30_usage)]
          ].each do |label, value| %>
            <div class="rounded-md bg-gray-50 p-3">
              <dt class="text-xs font-medium text-gray-500"><%= label %></dt>
              <dd class="mt-1 text-lg font-semibold text-gray-950"><%= value %></dd>
            </div>
          <% end %>
        </dl>
      </div>

      <div class="rounded-lg bg-white p-5 shadow ring-1 ring-black/5">
        <div class="flex items-center justify-between">
          <h3 class="text-base font-semibold text-gray-950">Cache</h3>
          <span class="rounded-full px-2.5 py-1 text-xs font-semibold <%= @installation.cache_enabled ? "bg-green-50 text-green-700" : "bg-gray-100 text-gray-600" %>"><%= @installation.cache_enabled ? "Enabled" : "Disabled" %></span>
        </div>
        <dl class="mt-4 space-y-3 text-sm">
          <div class="flex justify-between gap-4">
            <dt class="text-gray-500">Entries</dt>
            <dd class="font-medium text-gray-950"><%= @cache_entries_count %></dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-gray-500">Used</dt>
            <dd class="font-medium text-gray-950"><%= humanize_size(@cache_bytes) %> of <%= @installation.cache_storage_gib %> GB</dd>
          </div>
          <div class="flex justify-between gap-4">
            <dt class="text-gray-500">Scope protection</dt>
            <dd class="font-medium text-gray-950"><%= @installation.cache_scope_protected ? "On" : "Off" %></dd>
          </div>
        </dl>
        <div class="mt-4">
          <%== part("components/button", text: "Manage cache", link: "#{path(@installation)}/cache", icon: "hero-circle-stack") %>
        </div>
      </div>
    </div>
  </section>

  <section class="grid gap-6 xl:grid-cols-2">
    <div class="rounded-lg bg-white shadow ring-1 ring-black/5">
      <div class="border-b border-gray-200 px-5 py-4">
        <h3 class="text-base font-semibold text-gray-950">Connected repositories</h3>
      </div>
      <% if @repositories.empty? %>
        <div class="px-5 py-8 text-sm text-gray-500">No repositories have sent runner jobs yet. Configure repository access in GitHub, then push a workflow using a LayerRail runner label.</div>
      <% else %>
        <div class="divide-y divide-gray-100">
          <% @repositories.first(8).each do |repository| %>
            <div class="flex items-center justify-between gap-4 px-5 py-3">
              <div>
                <div class="font-medium text-gray-950"><%= repository.name %></div>
                <div class="mt-0.5 text-xs text-gray-500">Default branch <%= repository.default_branch || "unknown" %></div>
              </div>
              <div class="text-right text-sm text-gray-600">
                <div><%= repository.runners_dataset.count %> runners</div>
                <div class="text-xs text-gray-500">Last job <%= humanize_time(repository.last_job_at) %></div>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>

    <div class="rounded-lg bg-white shadow ring-1 ring-black/5">
      <div class="border-b border-gray-200 px-5 py-4">
        <h3 class="text-base font-semibold text-gray-950">Workflow snippet</h3>
      </div>
      <div class="p-5">
        <pre class="overflow-x-auto rounded-md bg-gray-950 p-4 text-xs leading-6 text-gray-100"><code>jobs:
  build:
    runs-on: layerrail-standard-2
    steps:
      - uses: actions/checkout@v4
      - run: npm ci
      - run: npm test</code></pre>
        <p class="mt-4 text-sm text-gray-600">Use larger labels like <span class="font-mono text-gray-950">layerrail-standard-8</span> or ARM labels like <span class="font-mono text-gray-950">layerrail-standard-4-arm</span> when a job needs more power.</p>
      </div>
    </div>
  </section>

  <% if @installation.project.reputation == "limited" && !(@installation.project.quota_available?("GithubRunnerVCpu", 0) && @installation.project.quota_available?("GithubRunnerVCpuArm", 0)) %>
    <div class="rounded-md bg-red-50 p-4">
      <div class="flex gap-3">
        <%== part("components/icon", name: "hero-squares-plus", classes: "h-5 w-5 text-red-400") %>
        <p class="text-sm font-medium text-red-800">
          You have reached your vCPU concurrency limit. Contact support@layerrail.com to increase runner concurrency.
        </p>
      </div>
    </div>
  <% end %>

  <%== part(
    "components/table_card",
    headers: ["Repository", "Runner", "Workflow Job", "Runtime", ""],
    rows:
      @runners.map do |runner|
        os = runner.label_data["boot_image"].match(/(ubuntu-\d{2})\d{2}/)[1]
        family = runner.vm&.family || runner.label_data["family"]
        [
          [
            [[
              [runner.repository_name, {link: runner.repository_url}],
              runner.workflow_job&.[]("head_branch")
            ], {}],
            [[
              [runner.ubid, {link: runner.runner_url}],
              [<<~CONTENT, {escape: false}],
                <div class="mt-1 flex flex-wrap gap-1">
                  <div class="rounded-md bg-slate-100 px-2 text-xs font-medium leading-5 text-slate-800">#{runner.label_data["vcpus"]} vCPU</div>
                  <div class="rounded-md px-2 text-xs font-medium leading-5 #{(family == "premium") ? "bg-layerrail-100 text-layerrail-600" : "bg-slate-100 text-slate-800"}">#{family}</div>
                  <div class="rounded-md bg-slate-100 px-2 text-xs font-medium leading-5 text-slate-800">#{runner.label_data["arch"]}</div>
                  <div class="rounded-md bg-slate-100 px-2 text-xs font-medium leading-5 text-slate-800">#{os}</div>
                </div>
              CONTENT
            ], {}],
            if (workflow_job = runner.workflow_job)
              [[
                [workflow_job["workflow_name"].to_s, {link: runner.run_url}],
                [workflow_job["name"].to_s, {link: runner.job_url}],
              ], {}]
            elsif runner.ready_at
              [["Waiting for GitHub to assign a job", "Ready for #{format_time_diff(runner.ready_at, Time.now)}"], {}]
            elsif runner.strand && runner.strand.label == "wait_concurrency_limit"
              [["Reached concurrency limit", "Waiting for #{format_time_diff(runner.created_at, Time.now)}"], {}]
            elsif runner.strand && runner.strand.label == "apply_custom_label_quota"
              [["Checking custom label quota", "Waiting for #{format_time_diff(runner.created_at, Time.now)}"], {}]
            else
              [["Provisioning ephemeral runner", "Waiting for #{format_time_diff(runner.created_at, Time.now)}"], {}]
            end,
            if (job = runner.workflow_job)
              [[
                "Running for #{format_time_diff(Time.parse(job["started_at"]), Time.now)}",
                "Started in #{format_time_diff(Time.parse(job["created_at"]), Time.parse(job["started_at"]))}"
              ], {}]
            elsif runner.allocated_at
              [["Allocated #{format_time_diff(runner.allocated_at, Time.now)} ago", runner.strand_label], {}]
            else
              [["Not allocated yet", runner.strand_label], {}]
            end,
            [
              "delete_button",
              {
                component: {
                  url: "#{@project.path}/github/#{@installation.ubid}/runner/#{runner.ubid}",
                  text: nil,
                  icon: "hero-x-circle",
                  confirmation_message: "Are you sure you want to terminate this runner?\nThis can cancel the current job and delete temporary runner data.",
                  attributes: {"title" => "Terminate"}
                },
                extra_class: "text-right"
              }
            ]
          ],
          { id: "runner-#{runner.ubid}" }
        ]
      end,
    empty_state: <<~EMPTY
      <div class="px-6 py-12 text-center">
        #{part("components/icon", name: "hero-rocket-launch", classes: "mx-auto h-12 w-12 text-gray-400")}
        <h3 class="mt-3 text-xl font-semibold text-gray-900">No active runners</h3>
        <p class="mx-auto mt-2 max-w-lg text-sm text-gray-600">Trigger a GitHub Actions workflow with a LayerRail label and the runner will appear here while it is queued, starting, running, and cleaning up.</p>
      </div>
    EMPTY
  ) %>
</div>
