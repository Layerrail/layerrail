<% @page_title = @alert.name %>

<%== part("components/page_header", title: @alert.name, breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Monitoring", "#{@project.path}/monitoring"], [@alert.name, "#"]]) %>

<div class="grid gap-6">
  <div class="rounded-lg bg-white shadow">
    <dl class="divide-y divide-gray-200">
      <% [
        ["Condition", @alert.display_condition],
        ["Severity", @alert.severity],
        ["Status", @alert.enabled ? "enabled" : "disabled"],
        ["Uptime check", @alert.uptime_check&.name || "Any"],
        ["Notification channel", @alert.notification_channel&.name || "None"],
        ["Last triggered", @alert.last_triggered_at || "Never"]
      ].each do |label, value| %>
        <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="text-sm font-medium text-gray-500"><%= label %></dt>
          <dd class="mt-1 break-all text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <div class="flex flex-wrap gap-3 rounded-lg bg-white p-6 shadow">
    <% form(action: "#{@project.path}#{@alert.path}/toggle", method: :post) do %>
      <%== part("components/form/submit_button", text: @alert.enabled ? "Disable Alert" : "Enable Alert", icon: "hero-megaphone") %>
    <% end %>
    <%== part("components/delete_button", url: "#{@project.path}#{@alert.path}", text: "Delete Alert") %>
  </div>

  <div class="rounded-lg bg-white shadow">
    <div class="border-b border-gray-200 px-6 py-4"><h2 class="text-base font-semibold text-gray-950">Incidents</h2></div>
    <% if @incidents.empty? %>
      <div class="px-6 py-10 text-sm text-gray-500">This alert has not opened any incidents.</div>
    <% else %>
      <%== part("components/table_card", headers: ["Incident", "Severity", "Status", "Opened"], rows: @incidents.map { |incident| [[[incident.title, {link: "#{@project.path}#{incident.path}"}], [incident.severity], [incident.status], [incident.opened_at]], {id: "incident-#{incident.ubid}"}] }) %>
    <% end %>
  </div>
</div>
