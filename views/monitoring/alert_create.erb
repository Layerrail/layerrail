<% @page_title = "Create Alert" %>

<%== part("components/page_header", title: "Create Alert", breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Monitoring", "#{@project.path}/monitoring"], ["Alert", "#"]]) %>

<div class="rounded-lg bg-white p-6 shadow">
  <% form(action: "#{@project.path}/monitoring/alerts", method: :post) do %>
    <div class="grid gap-6 md:grid-cols-2">
      <%== part("components/form/text", label: "Name", name: "name", attributes: {placeholder: "website-down", required: true}) %>
      <div>
        <label class="block text-sm font-medium leading-6 text-gray-900">Resource</label>
        <select name="resource_type" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600 sm:text-sm sm:leading-6">
          <option value="uptime">Uptime</option>
          <option value="metrics">Metrics</option>
          <option value="logs">Logs</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium leading-6 text-gray-900">Uptime check</label>
        <select name="uptime_check_id" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600 sm:text-sm sm:leading-6">
          <option value="">Any check</option>
          <% @uptime_checks.each do |check| %>
            <option value="<%= check.id %>"><%= check.name %></option>
          <% end %>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium leading-6 text-gray-900">Condition</label>
        <select name="condition" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600 sm:text-sm sm:leading-6">
          <option value="down">Service is down</option>
          <option value="status_not_expected">Status is not expected</option>
          <option value="latency_ms_gt">Latency above threshold</option>
          <option value="metric_gt">Metric above threshold</option>
          <option value="log_match">Log pattern matched</option>
        </select>
      </div>
      <%== part("components/form/text", label: "Threshold", name: "threshold", attributes: {type: "number", placeholder: "1000"}) %>
      <div>
        <label class="block text-sm font-medium leading-6 text-gray-900">Severity</label>
        <select name="severity" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600 sm:text-sm sm:leading-6">
          <option value="warning">Warning</option>
          <option value="critical">Critical</option>
          <option value="info">Info</option>
        </select>
      </div>
      <div>
        <label class="block text-sm font-medium leading-6 text-gray-900">Notification channel</label>
        <select name="notification_channel_id" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600 sm:text-sm sm:leading-6">
          <option value="">None</option>
          <% @channels.each do |channel| %>
            <option value="<%= channel.id %>"><%= channel.name %></option>
          <% end %>
        </select>
      </div>
    </div>
    <div class="mt-6"><%== part("components/form/submit_button", text: "Create Alert", icon: "hero-plus") %></div>
  <% end %>
</div>
