<% @page_title = "Create Notification Channel" %>

<%== part("components/page_header", title: "Create Notification Channel", breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Monitoring", "#{@project.path}/monitoring"], ["Channel", "#"]]) %>

<div class="rounded-lg bg-white p-6 shadow">
  <% form(action: "#{@project.path}/monitoring/notification-channels", method: :post) do %>
    <div class="grid gap-6 md:grid-cols-3">
      <%== part("components/form/text", label: "Name", name: "name", attributes: {placeholder: "support", required: true}) %>
      <div>
        <label class="block text-sm font-medium leading-6 text-gray-900">Type</label>
        <select name="kind" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600 sm:text-sm sm:leading-6">
          <option value="email">Email</option>
          <option value="webhook">Webhook</option>
        </select>
      </div>
      <%== part("components/form/text", label: "Target", name: "target", attributes: {placeholder: "support@layerrail.com or https://...", required: true}) %>
    </div>
    <div class="mt-6"><%== part("components/form/submit_button", text: "Create Channel", icon: "hero-plus") %></div>
  <% end %>
</div>
