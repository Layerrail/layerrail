<% policy = @vm.vm_backup_policy
snapshots = @vm.vm_backup_snapshots
provider_supported = @vm.backup_provider == "azure"
%>

<div class="space-y-6 p-6">
  <div class="rounded-lg bg-white p-6 shadow">
    <div class="md:flex md:items-start md:justify-between">
      <div>
        <h3 class="text-lg font-semibold leading-6 text-gray-900">Backup policy</h3>
        <p class="mt-1 text-sm text-gray-500">Create point-in-time disk snapshots for this virtual machine and keep them for a fixed retention window.</p>
      </div>
      <% form(action: "#{path(@vm)}/backups/create", method: :post) do %>
        <%== part("components/form/submit_button", text: "Create backup now", extra_class: "mt-4 md:mt-0", attributes: {disabled: !provider_supported}) %>
      <% end %>
    </div>

    <% unless provider_supported %>
      <div class="mt-4 rounded-md bg-yellow-50 p-4 text-sm text-yellow-800">
        VM snapshots are currently wired for Azure-backed virtual machines. This VM is running on <%= @vm.backup_provider %>.
      </div>
    <% end %>

    <% form(action: "#{path(@vm)}/backups", method: :post) do %>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        <div>
          <label class="block text-sm font-medium leading-6 text-gray-900">Protection</label>
          <select name="enabled" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600 sm:text-sm sm:leading-6">
            <option value="true" <%= "selected" if policy.nil? || policy.enabled %>>Enabled</option>
            <option value="false" <%= "selected" if policy && !policy.enabled %>>Paused</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium leading-6 text-gray-900">Schedule</label>
          <select name="schedule_hours" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600 sm:text-sm sm:leading-6">
            <% [[6, "Every 6 hours"], [12, "Every 12 hours"], [24, "Daily"], [168, "Weekly"]].each do |hours, label| %>
              <option value="<%= hours %>" <%= "selected" if (policy&.schedule_hours || 24) == hours %>><%= label %></option>
            <% end %>
          </select>
        </div>
        <div>
          <label class="block text-sm font-medium leading-6 text-gray-900">Retention</label>
          <select name="retention_days" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600 sm:text-sm sm:leading-6">
            <% [3, 7, 14, 30, 60, 90].each do |days| %>
              <option value="<%= days %>" <%= "selected" if (policy&.retention_days || 7) == days %>><%= days %> days</option>
            <% end %>
          </select>
        </div>
      </div>
      <div class="mt-6">
        <%== part("components/form/submit_button", text: "Save backup policy", attributes: {disabled: !provider_supported}) %>
      </div>
    <% end %>

    <% if policy&.last_error %>
      <div class="mt-4 rounded-md bg-red-50 p-4 text-sm text-red-700"><%= policy.last_error %></div>
    <% end %>
  </div>

  <div class="overflow-hidden rounded-lg bg-white shadow">
    <div class="border-b border-gray-200 px-6 py-5">
      <h3 class="text-lg font-semibold leading-6 text-gray-900">Snapshots</h3>
      <p class="mt-1 text-sm text-gray-500">Each snapshot captures the OS disk and attached data disks for this VM.</p>
    </div>

    <% if snapshots.empty? %>
      <div class="px-6 py-12 text-center text-sm text-gray-500">No VM snapshots yet.</div>
    <% else %>
      <table class="min-w-full divide-y divide-gray-200">
        <thead class="bg-gray-50">
          <tr>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Created</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">State</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Disks</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Size</th>
            <th class="px-6 py-3 text-left text-xs font-medium uppercase tracking-wide text-gray-500">Expires</th>
            <th class="px-6 py-3 text-right text-xs font-medium uppercase tracking-wide text-gray-500">Restore</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-200 bg-white">
          <% snapshots.each do |snapshot| %>
            <tr>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900"><%= snapshot.created_at.utc.strftime("%b %-d, %Y %H:%M UTC") %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-900"><%= snapshot.state.capitalize %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= Array(snapshot.snapshot_refs).count %></td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= snapshot.size_gib %> GiB</td>
              <td class="whitespace-nowrap px-6 py-4 text-sm text-gray-500"><%= snapshot.expires_at.utc.strftime("%b %-d, %Y") %></td>
              <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
                <% if snapshot.restore_vm_id %>
                  <span class="text-gray-500">Restored</span>
                <% elsif snapshot.available? && snapshot.provider == "azure" %>
                  <% form(action: "#{path(@vm)}/backups/#{snapshot.id}/restore", method: :post) do %>
                    <input
                      type="text"
                      name="restore_name"
                      value="<%= "#{@vm.name}-restore" %>"
                      class="mr-2 inline-block w-44 rounded-md border-0 py-1.5 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600"
                    >
                    <%== part("components/form/submit_button", text: "Restore") %>
                  <% end %>
                <% else %>
                  <span class="text-gray-400">Unavailable</span>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    <% end %>
  </div>
</div>
