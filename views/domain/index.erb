<% @page_title = "Domains" %>

<%== part(
  "components/page_header",
  breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Domains", "#"]],
  right_items: [
    part("components/button", text: "Transfer Domain", link: "#{@project.path}/domain/transfer", icon: "hero-arrow-top-right-on-square"),
    part("components/button", text: "Register Domain", link: "#{@project.path}/domain/create", icon: "hero-globe-alt")
  ]
) %>

<%== render("domain/tabbar", locals: {active: "domains"}) %>

<div class="grid gap-6">
  <% registration_cart = @domain_registrations.select { |domain_registration| domain_registration.status == "cart" } %>
  <% order_cart = @domain_orders.select { |domain_order| domain_order.status == "cart" } %>
  <% pending_checkout = @domain_registrations.select { |domain_registration| domain_registration.status == "pending_payment" } + @domain_orders.select { |domain_order| domain_order.status == "pending_payment" } %>
  <% visible_registrations = @domain_registrations.reject { |domain_registration| %w[cart pending_payment cancelled].include?(domain_registration.status) } %>
  <% visible_orders = @domain_orders.reject { |domain_order| %w[cart pending_payment cancelled].include?(domain_order.status) } %>
  <% cart = registration_cart + order_cart %>
  <% if cart.any? %>
    <section class="rounded-lg bg-white shadow ring-1 ring-black ring-opacity-5">
      <div class="border-b border-gray-100 px-6 py-5">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <h2 class="text-base font-semibold text-gray-900">Cart</h2>
          <div class="text-sm font-semibold text-gray-900">$<%= format("%0.2f", cart.sum { it.amount_cents.to_i } / 100.0) %></div>
        </div>
      </div>
      <div class="divide-y divide-gray-100">
        <% cart.each do |item| %>
          <div id="domain-cart-<%= item.ubid %>" class="grid gap-4 px-6 py-4 text-sm md:grid-cols-[1fr_130px_90px_120px] md:items-center">
            <div>
              <a class="font-medium text-gray-900 hover:text-layerrail-600" href="<%= path(item) %>"><%= item.domain %></a>
              <div class="mt-1 text-xs text-gray-500"><%= item.ubid %></div>
            </div>
            <div class="text-gray-500"><%= item.is_a?(DomainRegistration) ? "registration" : item.display_kind %></div>
            <div class="text-gray-500"><%= item.years %> yr</div>
            <div class="font-medium text-gray-900"><%= item.amount_label %></div>
          </div>
        <% end %>
      </div>
      <div class="flex flex-wrap justify-end gap-3 border-t border-gray-100 px-6 py-4">
        <% form(action: "#{@project.path}/domain/cart-clear", method: :post) do %>
          <%== part(
            "components/button",
            text: "Empty Cart",
            icon: "hero-trash",
            type: "danger",
            attributes: {
              "type" => "submit",
              "data-confirmation" => "empty cart",
              "data-confirmation-message" => "This removes every unpaid domain item from your cart."
            }
          ) %>
        <% end %>
        <% form(action: "#{@project.path}/domain/checkout", method: :post) do %>
          <%== part("components/button", text: "Checkout", icon: "hero-banknotes", attributes: {"type" => "submit"}) %>
        <% end %>
      </div>
    </section>
  <% end %>

  <% if pending_checkout.any? %>
    <%== part(
      "components/table_card",
      title: "Pending checkout",
      headers: ["Item", "Kind", "Years", "Amount", "State"],
      rows: pending_checkout.map do |item|
        [
          [
            [[item.domain, {link: path(item)}], [item.ubid, {copyable: true}]],
            item.is_a?(DomainRegistration) ? "registration" : item.display_kind,
            item.years,
            item.amount_label,
            item.display_state
          ],
          {id: "domain-pending-#{item.ubid}"}
        ]
      end
    ) %>
  <% end %>

  <%== part(
    "components/table_card",
    title: "Registered domains",
    headers: ["Domain", "Years", "Price", "State", "DNS", "Auto-renew", "Expires"],
    rows: visible_registrations.map do |domain_registration|
      [
        [
          [
            [domain_registration.domain, {link: path(domain_registration)}],
            [domain_registration.ubid, {copyable: true}]
          ],
          domain_registration.years,
          domain_registration.unit_price_label,
          domain_registration.display_state,
          domain_registration.project_attachment_label,
          domain_registration.auto_renew ? "On" : "Off",
          domain_registration.expires_at_label
        ],
        {id: "domain-registration-#{domain_registration.ubid}"}
      ]
    end,
    empty_state: {
      icon: "hero-globe-alt",
      title: "No registered domains yet",
      description: "Search for a domain, add it to your cart, and LayerRail will create the registration with a managed DNS zone.",
      button_link: "#{@project.path}/domain/create",
      button_title: "Register Domain"
    }
  ) %>

  <%== part(
    "components/table_card",
    title: "Requests",
    headers: ["Domain", "Kind", "Years", "Amount", "State", "Due", "Completed"],
    rows: visible_orders.map do |domain_order|
      [
        [
          [
            [domain_order.domain, {link: path(domain_order)}],
            [domain_order.ubid, {copyable: true}]
          ],
          domain_order.display_kind,
          domain_order.years,
          domain_order.amount_label,
          domain_order.display_state,
          domain_order.due_at_label,
          domain_order.completed_at_label
        ],
        {id: "domain-order-#{domain_order.ubid}"}
      ]
    end
  ) %>
</div>
