<% @page_title = @domain_registration.domain %>

<%== part(
  "components/page_header",
  breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Domains", "#{@project.path}/domain"], [@domain_registration.domain, "#"]],
  right_items: [part("components/button", text: "Back to Domains", link: "#{@project.path}/domain", icon: "hero-chevron-left")]
) %>

<% if @domain_registration.locked_for_abuse? || @domain_registration.under_abuse_review? %>
  <div class="mb-6 rounded-lg border border-amber-200 bg-amber-50 p-4">
    <div class="text-sm font-semibold text-amber-900">Domain review</div>
    <p class="mt-1 text-sm text-amber-800">
      This domain is marked as <%= @domain_registration.abuse_label %>.
      <% if @domain_registration.abuse_reason %>
        Reason: <%= @domain_registration.abuse_reason %>
      <% end %>
    </p>
  </div>
<% end %>

<div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
  <div class="space-y-6">
    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <div class="text-sm font-medium text-layerrail-600">Domain</div>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900"><%= @domain_registration.domain %></h2>
        </div>
        <div class="rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-700"><%= @domain_registration.display_state %></div>
      </div>

      <dl class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Registration price</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.unit_price_label %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Total amount</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.amount_label %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Years</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.years %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Expires</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.expires_at_label %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">DNS zone</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.dns_zone_label %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Contact profile</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.contact_profile&.name || "Provider default" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Auto-renew</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.auto_renew ? "On" : "Off" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Next renewal check</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.next_auto_renewal_label %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Project attach</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.project_attachment_label %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Deploy app</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.deploy_attachment_label %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">DNSSEC</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.dnssec_label %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Forwarding</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.forwarding_enabled ? "On" : "Off" %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Email alerts</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.notifications_label %></dd>
        </div>
      </dl>
    </div>

    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
      <h3 class="text-lg font-semibold text-gray-900">Nameservers</h3>
      <% if @domain_registration.nameservers.to_a.any? %>
        <ul class="mt-4 space-y-2 text-sm text-gray-700">
          <% @domain_registration.nameservers.each do |nameserver| %>
            <li><code class="rounded bg-gray-100 px-2 py-1"><%= nameserver %></code></li>
          <% end %>
        </ul>
      <% else %>
        <p class="mt-3 text-sm text-gray-600">Provider defaults are being used.</p>
      <% end %>
    </div>

    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
      <h3 class="text-lg font-semibold text-gray-900">DNSSEC records</h3>
      <% if @domain_registration.dnssec_records.to_a.any? %>
        <div class="mt-4 overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200 text-left text-sm">
            <thead class="text-gray-500">
              <tr>
                <th class="py-2 pr-4 font-medium">Key tag</th>
                <th class="py-2 pr-4 font-medium">Algorithm</th>
                <th class="py-2 pr-4 font-medium">Digest type</th>
                <th class="py-2 pr-4 font-medium">Digest</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 text-gray-700">
              <% @domain_registration.dnssec_records.each do |record| %>
                <tr>
                  <td class="py-2 pr-4"><%= record["keytag"] %></td>
                  <td class="py-2 pr-4"><%= record["algorithm"] %></td>
                  <td class="py-2 pr-4"><%= record["digest_type"] %></td>
                  <td class="py-2 pr-4"><code class="break-all"><%= record["digest"] %></code></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% else %>
        <p class="mt-3 text-sm text-gray-600">DNSSEC is not configured yet.</p>
      <% end %>
    </div>

    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
      <h3 class="text-lg font-semibold text-gray-900">Forwarding</h3>
      <p class="mt-3 text-sm text-gray-600"><%= @domain_registration.forwarding_label %></p>
    </div>

    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
      <h3 class="text-lg font-semibold text-gray-900">Provider details</h3>
      <div class="mt-4 overflow-hidden rounded-lg bg-gray-50 p-4 text-sm text-gray-700">
        <pre class="whitespace-pre-wrap break-words"><%= JSON.pretty_generate(@domain_registration.provider_payload || {}) %></pre>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <% if @domain_registration.active? %>
      <% form(action: "#{path(@domain_registration)}/renew", method: :post, class: "rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5") do %>
        <h3 class="text-lg font-semibold text-gray-900">Renew domain</h3>
        <p class="mt-3 text-sm text-gray-600">Add a renewal order to your cart and checkout through Polar.</p>
        <div class="mt-4">
          <%== part(
            "components/form/select",
            name: "years",
            label: "Years",
            selected: 1,
            options: (1..10).map { |year| [year, "#{year} year#{year == 1 ? "" : "s"}"] }
          ) %>
        </div>
        <div class="mt-4 flex justify-end">
          <%== part("components/form/submit_button", text: "Add Renewal to Cart", icon: "hero-arrow-path") %>
        </div>
      <% end %>

      <% form(action: "#{path(@domain_registration)}/#{@domain_registration.project_attached_at ? "detach" : "attach"}", method: :post, class: "rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5") do %>
        <h3 class="text-lg font-semibold text-gray-900">Project DNS zone</h3>
        <p class="mt-3 text-sm text-gray-600">Attach this domain to the current project so LayerRail can manage records for it.</p>
        <div class="mt-4 flex justify-end">
          <%== part("components/form/submit_button", text: @domain_registration.project_attached_at ? "Detach Zone" : "Attach Zone", icon: "hero-globe-alt") %>
        </div>
      <% end %>

      <% form(action: "#{path(@domain_registration)}/deploy-app", method: :post, class: "rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5") do %>
        <h3 class="text-lg font-semibold text-gray-900">Deploy app domain</h3>
        <p class="mt-3 text-sm text-gray-600">Attach this domain to a LayerRail Deploy app and use it as the app hostname.</p>
        <div class="mt-4">
          <%== part(
            "components/form/select",
            name: "deploy_app_id",
            label: "Deploy app",
            selected: @domain_registration.deploy_app&.ubid,
            options: @deploy_apps.map { [it.ubid, "#{it.name} (#{it.public_hostname})"] }
          ) %>
        </div>
        <div class="mt-4 flex flex-wrap justify-end gap-3">
          <%== part("components/button", text: "Detach", type: "warning", attributes: {"type" => "submit", "name" => "action", "value" => "detach"}) if @domain_registration.deploy_app %>
          <%== part("components/button", text: "Attach App", attributes: {"type" => "submit", "name" => "action", "value" => "attach"}) %>
        </div>
      <% end %>

      <% form(action: "#{path(@domain_registration)}/team-policy", method: :post, class: "rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5") do %>
        <h3 class="text-lg font-semibold text-gray-900">Team policy</h3>
        <p class="mt-3 text-sm text-gray-600">Set the intended operator level for domain actions. Core project permissions still protect all changes.</p>
        <div class="mt-4 space-y-4">
          <% [
            ["manage_dns_role", "Manage DNS", "manage_dns"],
            ["renew_role", "Renew domains", "renew"],
            ["transfer_role", "Transfer domains", "transfer"]
          ].each do |name, label, key| %>
            <%== part(
              "components/form/select",
              name:,
              label:,
              selected: @domain_registration.team_policy.to_h.fetch(key, key == "renew" ? "project_billing" : "project_admin"),
              options: [["project_admin", "Project admin"], ["project_billing", "Billing operator"], ["project_member", "Project member"]]
            ) %>
          <% end %>
        </div>
        <div class="mt-4 flex justify-end">
          <%== part("components/form/submit_button", text: "Save Policy", icon: "hero-users") %>
        </div>
      <% end %>

      <% form(action: "#{path(@domain_registration)}/auto-renew", method: :post, class: "rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5") do %>
        <h3 class="text-lg font-semibold text-gray-900">Auto-renewal</h3>
        <p class="mt-3 text-sm text-gray-600">Keep this domain scheduled for renewal before expiration.</p>
        <input type="hidden" name="enabled" value="<%= @domain_registration.auto_renew ? "false" : "true" %>">
        <div class="mt-4 flex justify-end">
          <%== part("components/form/submit_button", text: @domain_registration.auto_renew ? "Disable Auto-renew" : "Enable Auto-renew", icon: "hero-arrow-path") %>
        </div>
      <% end %>

      <% form(action: "#{path(@domain_registration)}/notifications", method: :post, class: "rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5") do %>
        <h3 class="text-lg font-semibold text-gray-900">Email alerts</h3>
        <p class="mt-3 text-sm text-gray-600">Send domain lifecycle updates to project members.</p>
        <p class="mt-1 text-xs text-gray-500">Last sent: <%= @domain_registration.last_notification_at&.strftime("%Y-%m-%d %H:%M") || "-" %></p>
        <input type="hidden" name="enabled" value="<%= @domain_registration.notifications_enabled ? "false" : "true" %>">
        <div class="mt-4 flex justify-end">
          <%== part("components/form/submit_button", text: @domain_registration.notifications_enabled ? "Disable Alerts" : "Enable Alerts", icon: "hero-envelope") %>
        </div>
      <% end %>

      <% form(action: "#{path(@domain_registration)}/forwarding", method: :post, class: "rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5") do %>
        <h3 class="text-lg font-semibold text-gray-900">Domain forwarding</h3>
        <p class="mt-3 text-sm text-gray-600">Forward this domain to another URL.</p>
        <div class="mt-4 space-y-4">
          <div>
            <label class="text-sm font-medium leading-6 text-gray-900" for="forwarding_url">Target URL</label>
            <input class="mt-2 block w-full rounded-md border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-layerrail-600" id="forwarding_url" name="forwarding_url" value="<%= @domain_registration.forwarding_url %>" placeholder="https://example.com">
          </div>
          <%== part(
            "components/form/select",
            name: "forwarding_type",
            label: "Forwarding type",
            selected: @domain_registration.forwarding_type || "302",
            options: [["302", "Temporary redirect"], ["301", "Permanent redirect"], ["masked", "Masked forwarding"]]
          ) %>
        </div>
        <div class="mt-4 flex flex-wrap justify-end gap-3">
          <%== part("components/button", text: "Disable", type: "warning", attributes: {"type" => "submit", "name" => "action", "value" => "disable"}) if @domain_registration.forwarding_enabled %>
          <%== part("components/button", text: "Enable Forwarding", attributes: {"type" => "submit", "name" => "action", "value" => "enable"}) %>
        </div>
      <% end %>

      <% form(action: "#{path(@domain_registration)}/dnssec", method: :post, class: "rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5") do %>
        <h3 class="text-lg font-semibold text-gray-900">DNSSEC</h3>
        <p class="mt-3 text-sm text-gray-600">Add DS records from your DNSSEC signing setup.</p>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          <div>
            <label class="text-sm font-medium leading-6 text-gray-900" for="keytag">Key tag</label>
            <input class="mt-2 block w-full rounded-md border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600" id="keytag" name="keytag">
          </div>
          <div>
            <label class="text-sm font-medium leading-6 text-gray-900" for="algorithm">Algorithm</label>
            <input class="mt-2 block w-full rounded-md border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600" id="algorithm" name="algorithm">
          </div>
          <div>
            <label class="text-sm font-medium leading-6 text-gray-900" for="digest_type">Digest type</label>
            <input class="mt-2 block w-full rounded-md border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600" id="digest_type" name="digest_type">
          </div>
          <div>
            <label class="text-sm font-medium leading-6 text-gray-900" for="digest">Digest</label>
            <input class="mt-2 block w-full rounded-md border-0 px-3 py-2 text-sm text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600" id="digest" name="digest">
          </div>
        </div>
        <div class="mt-4 flex flex-wrap justify-end gap-3">
          <%== part("components/button", text: "Clear DNSSEC", type: "warning", attributes: {"type" => "submit", "name" => "action", "value" => "clear"}) if @domain_registration.dnssec_records.to_a.any? %>
          <%== part("components/button", text: "Add Record", attributes: {"type" => "submit", "name" => "action", "value" => "add"}) %>
        </div>
      <% end %>
    <% end %>

    <% if @domain_registration.failure_message %>
      <div class="rounded-lg border border-red-200 bg-red-50 p-6">
        <h3 class="text-lg font-semibold text-red-900">Registration failed</h3>
        <p class="mt-2 text-sm text-red-800"><%= @domain_registration.failure_message %></p>
        <% if @domain_registration.status == "failed" %>
          <% form(action: "#{path(@domain_registration)}/retry", method: :post, class: "mt-4") do %>
            <%== part("components/form/submit_button", text: "Retry registration", icon: "hero-arrow-path") %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if %w[cart pending_payment].include?(@domain_registration.status) %>
      <% form(action: "#{path(@domain_registration)}/remove", method: :post, class: "rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5") do %>
        <h3 class="text-lg font-semibold text-gray-900">Cart actions</h3>
        <p class="mt-3 text-sm text-gray-600">Remove this domain from your cart if you no longer want to register it.</p>
        <div class="mt-4 flex justify-end">
          <%== part("components/button", text: "Remove from Cart", type: "danger", icon: "hero-trash", attributes: {"type" => "submit"}) %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
