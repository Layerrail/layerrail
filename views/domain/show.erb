<% @page_title = @domain_registration.domain %>

<%== part(
  "components/page_header",
  breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Domains", "#{@project.path}/domain"], [@domain_registration.domain, "#"]],
  right_items: [part("components/button", text: "Back to Domains", link: "#{@project.path}/domain", icon: "hero-chevron-left")]
) %>

<div class="grid gap-6 lg:grid-cols-[1.15fr_0.85fr]">
  <div class="space-y-6">
    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <div class="text-sm font-medium text-layerrail-600">Domain</div>
          <h2 class="mt-2 text-3xl font-bold tracking-tight text-gray-900"><%= @domain_registration.domain %></h2>
        </div>
        <div class="rounded-full bg-gray-100 px-3 py-1 text-sm font-medium text-gray-700"><%= @domain_registration.display_state %></div>
      </div>

      <dl class="mt-6 grid gap-4 sm:grid-cols-2">
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Registration price</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.unit_price_label %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Total amount</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.amount_label %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Years</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.years %></dd>
        </div>
        <div class="rounded-lg bg-gray-50 p-4">
          <dt class="text-sm font-medium text-gray-500">Checkout</dt>
          <dd class="mt-1 text-lg font-semibold text-gray-900"><%= @domain_registration.checkout_id || "Not attached yet" %></dd>
        </div>
      </dl>
    </div>

    <div class="rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5">
      <h3 class="text-lg font-semibold text-gray-900">Provider details</h3>
      <div class="mt-4 overflow-hidden rounded-lg bg-gray-50 p-4 text-sm text-gray-700">
        <pre class="whitespace-pre-wrap break-words"><%= JSON.pretty_generate(@domain_registration.provider_payload || {}) %></pre>
      </div>
    </div>
  </div>

  <div class="space-y-6">
    <% if @domain_registration.failure_message %>
      <div class="rounded-lg border border-red-200 bg-red-50 p-6">
        <h3 class="text-lg font-semibold text-red-900">Registration failed</h3>
        <p class="mt-2 text-sm text-red-800"><%= @domain_registration.failure_message %></p>
        <% if @domain_registration.status == "failed" %>
          <% form(action: "#{path(@domain_registration)}/retry", method: :post, class: "mt-4") do %>
            <%== part("components/form/submit_button", text: "Retry registration", icon: "hero-arrow-path") %>
          <% end %>
        <% end %>
      </div>
    <% end %>

    <% if %w[cart pending_payment].include?(@domain_registration.status) %>
      <% form(action: "#{path(@domain_registration)}/remove", method: :post, class: "rounded-lg bg-white p-6 shadow ring-1 ring-black ring-opacity-5") do %>
        <h3 class="text-lg font-semibold text-gray-900">Cart actions</h3>
        <p class="mt-3 text-sm text-gray-600">Remove this domain from your cart if you no longer want to register it.</p>
        <div class="mt-4 flex justify-end">
          <%== part("components/button", text: "Remove from Cart", type: "danger", icon: "hero-trash", attributes: {"type" => "submit"}) %>
        </div>
      <% end %>
    <% end %>
  </div>
</div>
