<%# locals: (url:, is_active:, icon:, name:, html_id: nil, has_permission: true, target: nil, rel: nil) %>

<% if has_permission %>
  <li>
    <a
      href="<%= url %>"
      <% if html_id %>
        id="<%= html_id %>"
      <% end %>
      <% if target %>
        target="<%= target %>"
      <% end %>
      <% if rel %>
        rel="<%= rel %>"
      <% end %>
      class="<%= is_active ? "bg-layerrail-700 text-white" : "text-layerrail-100 hover:text-white hover:bg-layerrail-700" %> group flex gap-x-3 rounded-md p-2 text-sm leading-6 font-semibold"
    >
      <%== part("components/icon", name: icon, classes: "h-6 w-6 shrink-0 text-white") %>
      <%= name %>
    </a>
  </li>
<% end %>
