<div class="flex grow flex-col gap-y-5 overflow-y-auto bg-layerrail-600 px-6">
  <div class="flex h-16 shrink-0 items-center">
    <a href="<%= @project_permissions ? "#{@project.path}/dashboard" : "/project" %>">
      <%== part("components/brand_mark", variant: "white") %>
    </a>
  </div>
  <nav class="flex flex-1 flex-col">
    <ul role="list" class="flex flex-1 flex-col gap-y-7">
      <% if @project_permissions %>
        <%== part("layouts/sidebar/section", items: [
          {
            name: "Dashboard",
            url: "#{@project.path}/dashboard",
            is_active: request.path.start_with?("#{@project.path}/dashboard"),
            icon: "hero-home",
          },
          {
            name: "Compute",
            url: "#{@project.path}/vm",
            is_active: request.path.start_with?("#{@project.path}/vm"),
            icon: "hero-server-stack",
          },
          {
            name: "Networking",
            url: "#{@project.path}/private-subnet",
            is_active:
              request.path.start_with?("#{@project.path}/private-subnet") ||
              request.path.start_with?("#{@project.path}/firewall") ||
              request.path.start_with?("#{@project.path}/load-balancer"),
            icon: "hero-globe-alt",
          },
          {
            name: "PostgreSQL",
            url: "#{@project.path}/postgres",
            is_active: request.path.start_with?("#{@project.path}/postgres"),
            icon: "hero-circle-stack",
            has_permission: Config.postgres_enabled,
          },
          {
            name: "AI Models",
            url: "#{@project.path}/inference-endpoint",
            is_active: request.path.start_with?("#{@project.path}/inference") || request.path.start_with?("#{@project.path}/ai-app"),
            icon: "tabler-robot",
            has_permission: Config.ai_inference_enabled,
          },
          {
            name: "Kubernetes",
            url: "#{@project.path}/kubernetes-cluster",
            is_active: request.path.start_with?("#{@project.path}/kubernetes-cluster"),
            icon: "kubernetes",
            has_permission: Config.kubernetes_enabled,
          },
          {
            name: "Game VPS",
            url: "#{@project.path}/game-vps",
            is_active: request.path.start_with?("#{@project.path}/game-vps"),
            icon: "hugeicons-game-controller-03",
            has_permission: Config.game_vps_enabled,
          },
          {
            name: "Deploy",
            url: "#{@project.path}/deploy",
            is_active: request.path.start_with?("#{@project.path}/deploy"),
            icon: "hero-cloud-arrow-up",
            has_permission: Config.deploy_enabled,
          },
          {
            name: "Web Shell",
            url: "#{@project.path}/cli",
            is_active: request.path.start_with?("#{@project.path}/cli"),
            icon: "shell",
          },
        ]) %>
      <% else %>
        <%== part("layouts/sidebar/section", items: [
          {
            name: "My Account",
            url: "/account",
            is_active: request.path.start_with?("/account"),
            icon: "hero-user",
          },
          {
            name: "Projects",
            url: "/project",
            is_active: request.path.start_with?("/project"),
            icon: "hero-folder-open",
          },
        ]) %>
      <% end %>
      <% if @project_permissions && has_project_permission(["Project:user", "Project:billing", "Project:view", "Project:viewaccess", "Project:token"]) %>
        <% if has_project_permission("Project:user")
             users_url = "#{@project.path}/user"
             users_label = "Users"
           elsif has_project_permission("Project:viewaccess")
             users_url = "#{@project.path}/user/access-control"
             users_label = "Access Control"
           end %>
        <%== part("layouts/sidebar/section", title: "Project Details", items: [
          {
            name: users_label,
            url: users_url,
            is_active: request.path.start_with?("#{@project.path}/user"),
            icon: "hero-users",
            has_permission: !!users_url,
          },
          {
            name: "Tokens",
            url: "#{@project.path}/token",
            is_active: request.path.start_with?("#{@project.path}/token"),
            icon: "hero-key",
            has_permission: has_project_permission("Project:token"),
          },
          {
            name: "Billing",
            url: "#{@project.path}/billing",
            is_active: request.path.start_with?("#{@project.path}/billing"),
            icon: "hero-banknotes",
            html_id: "billing-icon",
            has_permission: has_project_permission("Project:billing") && (Config.stripe_secret_key || Config.polar_verification_product_id || Config.polar_checkout_product_id),
          },
          {
            name: "Settings",
            url: @project.path,
            is_active: request.path == @project.path,
            icon: "hero-cog-6-tooth",
            has_permission: has_project_permission("Project:view"),
          },
          {
            name: "AWS Regions",
            url: "#{@project.path}/private-location",
            is_active: request.path.start_with?("#{@project.path}/private-location"),
            icon: "hero-map-pin",
            has_permission: @project.get_ff_private_locations,
          },
        ]) %>
      <% end %>
      <% if @project_permissions && has_project_permission("Project:github") && Config.github_app_name %>
        <%== part("layouts/sidebar/section", title: "Integrations", items: [
          {
            name: "GitHub Runners",
            url: "#{@project.path}/github",
            is_active: request.path.start_with?("#{@project.path}/github"),
            icon: "github",
            has_permission: has_project_permission("Project:github"),
          },
        ]) %>
      <% end %>
      <li class="mt-auto space-y-3">
        <% if intercom_messenger_enabled? %>
          <button
            type="button"
            data-intercom-open
            data-intercom-action="message"
            class="group flex w-full items-center gap-x-3 rounded-md bg-layerrail-700/60 px-2 py-2 text-left text-sm font-semibold leading-6 text-layerrail-100 hover:bg-layerrail-700 hover:text-white"
          >
            <%== part("components/icon", name: "hero-chat-bubble-bottom-center-text", classes: "h-6 w-6 shrink-0 text-white") %>
            Contact support
          </button>
        <% end %>
        <div class="rounded-md bg-layerrail-700/40 px-2 py-2">
          <iframe
            src="https://status.layerrail.com/badge?theme=dark"
            width="250"
            height="30"
            frameborder="0"
            scrolling="no"
            class="block max-w-full"
            title="LayerRail system status"
            style="color-scheme: normal"
          ></iframe>
        </div>
      </li>
      <li class="-mx-6">
        <%== render("layouts/sidebar/project_switcher") %>
      </li>
    </ul>
  </nav>
</div>
