<% @nodes = []
eager = [:assigned_vm_address, :strand, :semaphores]

@nodes +=
  @kc.nodes_dataset.eager(vm: eager).all.map do |node|
    vm = node.vm
    { name: vm.name, role: "Control Plane", state: node.state == "active" ? vm.display_state : node.state, hostname: vm.ip4_string }
  end

@nodes +=
  @kc
    .nodepools_dataset
    .eager(nodes: { vm: eager })
    .all
    .flat_map do |np|
      np.nodes.map do |node|
        vm = node.vm
        { name: vm.name, role: "Worker", state: node.state == "active" ? vm.display_state : node.state, hostname: vm.ip4_string }
      end
    end %>

<div class="p-6">
  <%== part(
    "components/table_card",
    title: "Nodes",
    headers: %w[Name Role State Hostname],
    empty_state: "This cluster doesn't have any nodes yet",
    rows:
      @nodes.map { |n| [[n[:name], n[:role], n[:state], [n[:hostname], { copyable: true }]], { id: "node-#{n[:name]}" }] }
  ) %>
</div>
