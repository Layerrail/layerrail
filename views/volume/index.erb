<% @page_title = "Volumes"

total_size = @block_volumes.sum(&:size_gib) + @attached_volumes.sum(&:size_gib)
standalone_count = @block_volumes.count
attached_count = @attached_volumes.count

volume_provider_id = lambda do |volume|
  if volume.azure_storage_volume
    volume.azure_disk_name
  elsif volume.linode_storage_volume
    volume.linode_storage_volume.volume_id
  elsif volume.storage_device
    volume.storage_device.name
  else
    "Managed by LayerRail"
  end
end
%>

<%== part(
  "components/page_header",
  title: "Volumes",
  breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Volumes", "#"]]
) %>

<div class="space-y-6">
  <div class="flex justify-end">
    <a href="<%= @project.path %>/volume/create" class="inline-flex items-center rounded-md bg-layerrail-600 px-3 py-2 text-sm font-semibold text-white shadow-sm hover:bg-layerrail-500">
      Create Volume
    </a>
  </div>

  <div class="grid gap-4 md:grid-cols-3">
    <div class="rounded-lg bg-white p-5 shadow">
      <div class="text-sm font-medium text-gray-500">Total block storage</div>
      <div class="mt-2 text-3xl font-semibold tracking-tight text-layerrail-600"><%= total_size %> GB</div>
    </div>
    <div class="rounded-lg bg-white p-5 shadow">
      <div class="text-sm font-medium text-gray-500">Standalone volumes</div>
      <div class="mt-2 text-3xl font-semibold tracking-tight text-layerrail-600"><%= standalone_count %></div>
    </div>
    <div class="rounded-lg bg-white p-5 shadow">
      <div class="text-sm font-medium text-gray-500">VM disks</div>
      <div class="mt-2 text-3xl font-semibold tracking-tight text-layerrail-600"><%= attached_count %></div>
    </div>
  </div>

  <% if @block_volumes.empty? && @attached_volumes.empty? %>
    <div class="rounded-lg bg-white p-12 text-center shadow">
      <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full bg-layerrail-50 text-layerrail-600">
        <%== part("components/icon", name: "hero-circle-stack", classes: "h-6 w-6") %>
      </div>
      <h3 class="mt-4 text-sm font-semibold text-gray-900">No volumes yet</h3>
      <p class="mt-1 text-sm text-gray-500">Create a standalone volume or a virtual machine to see storage here.</p>
    </div>
  <% else %>
    <% unless @block_volumes.empty? %>
      <%== part(
        "components/table_card",
        headers: ["Volume", "Location", "Size", "Attached to", "State"],
        rows: @block_volumes.map do |volume|
          [
            [
              [[volume.name, {link: "#{@project.path}#{volume.path}"}], [volume.provider_volume_name]],
              [volume.display_location],
              ["#{volume.size_gib} GB"],
              [volume.attached_vm ? volume.attached_vm.name : "Not attached"],
              [volume.state]
            ],
            {id: "block-volume-#{volume.ubid}"}
          ]
        end,
        allow_wrap: true
      ) %>
    <% end %>

    <% unless @attached_volumes.empty? %>
    <%== part(
      "components/table_card",
      headers: ["VM disk", "VM", "Location", "Size", "Device", "Protection"],
      rows: @attached_volumes.map do |volume|
        volume_type = volume.boot ? "OS disk" : "Data disk"
        encryption = (volume.key_encryption_key_1_id || volume.key_encryption_key_2_id) ? "Encrypted" : "Provider managed"
        [
          [
            [[volume.ubid, {link: "#{path(volume.vm)}/overview"}], [volume_type]],
            [[volume.vm.name, {link: path(volume.vm)}], [volume.vm.display_state]],
            [volume.vm.location.ui_name],
            ["#{volume.size_gib} GB"],
            [[volume_provider_id.call(volume).to_s], [volume.device_path]],
            [[encryption], [volume.track_written ? "Change tracking enabled" : "Snapshot ready"]]
          ],
          {id: "volume-#{volume.ubid}"}
        ]
      end,
      allow_wrap: true
    ) %>
    <% end %>
  <% end %>
</div>
