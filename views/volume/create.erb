<% @page_title = "Create Volume" %>

<%== part(
  "components/page_header",
  title: "Create Volume",
  breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Volumes", "#{@project.path}/volume"], ["Create", "#"]]
) %>

<div class="rounded-lg bg-white p-6 shadow">
  <% if @locations.empty? %>
    <div class="rounded-md bg-yellow-50 p-4 text-sm text-yellow-800">
      Block volumes are not available in any active location yet.
    </div>
  <% else %>
    <% form(action: "#{@project.path}/volume", method: :post) do %>
      <div class="grid gap-6 md:grid-cols-3">
        <%== part("components/form/text", label: "Volume name", name: "name", attributes: {placeholder: "data", required: true}) %>
        <%== part("components/form/text", label: "Size in GB", name: "size_gib", attributes: {type: "number", min: "10", max: "4096", value: "100", required: true}) %>
        <div>
          <label class="block text-sm font-medium leading-6 text-gray-900">Location</label>
          <select name="location_id" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600 sm:text-sm sm:leading-6">
            <% @locations.each do |location| %>
              <option value="<%= location.id %>"><%= location.ui_name %></option>
            <% end %>
          </select>
        </div>
      </div>
      <div class="mt-6">
        <%== part("components/form/submit_button", text: "Create Volume", icon: "hero-plus") %>
      </div>
    <% end %>
  <% end %>
</div>
