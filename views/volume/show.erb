<% @page_title = @block_volume.name %>

<%== part(
  "components/page_header",
  title: @block_volume.name,
  breadcrumbs: [%w[Projects /project], [@project.name, @project.path], ["Volumes", "#{@project.path}/volume"], [@block_volume.name, "#"]]
) %>

<div class="grid gap-6">
  <div class="rounded-lg bg-white shadow">
    <dl class="divide-y divide-gray-200">
      <% [
        ["State", @block_volume.state],
        ["Location", @block_volume.display_location],
        ["Size", "#{@block_volume.size_gib} GB"],
        ["Attached VM", @block_volume.attached_vm ? @block_volume.attached_vm.name : "Not attached"],
        ["Device", @block_volume.device_path || "Not mounted"],
        ["Provider volume", @block_volume.provider_volume_name]
      ].each do |label, value| %>
        <div class="px-6 py-4 sm:grid sm:grid-cols-3 sm:gap-4">
          <dt class="text-sm font-medium text-gray-500"><%= label %></dt>
          <dd class="mt-1 break-all text-sm text-gray-900 sm:col-span-2 sm:mt-0"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  </div>

  <% if @block_volume.last_error %>
    <div class="rounded-md bg-red-50 p-4 text-sm text-red-700"><%= @block_volume.last_error %></div>
  <% end %>

  <div class="rounded-lg bg-white p-6 shadow">
    <% if @block_volume.attachable? %>
      <% if @attachable_vms.empty? %>
        <p class="text-sm text-gray-500">No Azure VM is available in this volume location.</p>
      <% else %>
        <% form(action: "#{@project.path}#{@block_volume.path}/attach", method: :post) do %>
          <div class="max-w-md">
            <label class="block text-sm font-medium leading-6 text-gray-900">Attach to VM</label>
            <select name="vm_id" class="mt-2 block w-full rounded-md border-0 py-1.5 pl-3 pr-10 text-gray-900 ring-1 ring-inset ring-gray-300 focus:ring-2 focus:ring-layerrail-600 sm:text-sm sm:leading-6">
              <% @attachable_vms.each do |vm| %>
                <option value="<%= vm.id %>"><%= vm.name %> · <%= vm.location.ui_name %></option>
              <% end %>
            </select>
          </div>
          <div class="mt-4">
            <%== part("components/form/submit_button", text: "Attach Volume", icon: "hero-link") %>
          </div>
        <% end %>
      <% end %>
    <% elsif @block_volume.detachable? %>
      <% form(action: "#{@project.path}#{@block_volume.path}/detach", method: :post) do %>
        <%== part("components/form/submit_button", text: "Detach Volume", icon: "hero-x-mark") %>
      <% end %>
    <% end %>
  </div>

  <div class="rounded-lg bg-white p-6 shadow">
    <%== part("components/delete_button", url: "#{@project.path}#{@block_volume.path}", text: "Delete Volume") %>
  </div>
</div>
